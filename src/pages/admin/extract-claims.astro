---
// ADR 0016: Admin operations — governed deterministic claim extraction.
// Durable execution belongs behind the signed Worker admin route. The only
// page-local extraction path is the read-only diagnostic preview.
import AdminLayout from "../../layouts/AdminLayout.astro";
import { extractClaimsFromItem } from "../../../workers/ingestion/extract-claims";

export const prerender = false;

interface DebugSample {
  id: number;
  title: string;
  rawText: string;
  normalizedText: string;
  textLen: number;
  claimCount: number;
  claims: string[];
  sourceTier: string;
}

let debugSamples: DebugSample[] = [];
let debugError: string | null = null;

function safeReturnTo(value: string | null): string {
  return value === "/admin/review" ? value : "/admin/review";
}

const requestedReturnTo = safeReturnTo(Astro.url.searchParams.get("returnTo"));
const requestedClusterId = Number(Astro.url.searchParams.get("clusterId") ?? "0");
const contextClusterId = Number.isInteger(requestedClusterId) && requestedClusterId > 0 ? requestedClusterId : null;
const canExecuteExtraction = Astro.locals.operator?.role === "publisher";
const debugParams = new URLSearchParams({ debug: "1", returnTo: requestedReturnTo });
if (contextClusterId) debugParams.set("clusterId", String(contextClusterId));
const debugAction = `?${debugParams.toString()}`;

// Diagnostic mode intentionally stays pure: it reads a bounded sample and
// invokes only extractClaimsFromItem, never the database-backed runner.
if (Astro.request.method === "POST" && Astro.url.searchParams.has("debug")) {
  try {
    const db = Astro.locals.runtime.env.DB;
    const sampleRows = await db.prepare(
      `SELECT fi.id, fi.title, fi.summary, fi.content_excerpt, s.tier as source_tier, s.treatment as source_treatment
       FROM feed_items fi JOIN sources s ON s.id=fi.source_id
       WHERE fi.ingestion_status IN ('clustered','classified')
       AND (fi.summary IS NOT NULL OR fi.content_excerpt IS NOT NULL)
       AND fi.fetched_at >= datetime('now', '-7 days')
       LIMIT 3`
    ).all<{ id: number; title: string; summary: string | null; content_excerpt: string | null; source_tier: string; source_treatment: string }>();
    for (const row of sampleRows.results ?? []) {
      const rawText = [row.title, row.summary ?? "", row.content_excerpt ?? ""].join(". ");
      const normalizedText = rawText.replace(/<[^>]*>/g, "").replace(/\s+/g, " ").replace(/&#?[a-z0-9]+;/gi, "").trim();
      const rawClaims = extractClaimsFromItem(
        row as never,
        row.source_tier ?? "C",
        row.source_treatment ?? "",
      );
      debugSamples.push({
        id: row.id,
        title: row.title,
        rawText: rawText.substring(0, 300),
        normalizedText: normalizedText.substring(0, 300),
        textLen: normalizedText.length,
        claimCount: rawClaims.length,
        claims: rawClaims.slice(0, 3).map((claim) => claim.claimText.substring(0, 100)),
        sourceTier: row.source_tier ?? "C",
      });
    }
  } catch (error: unknown) {
    debugError = error instanceof Error ? error.message : "The diagnostic sample could not be loaded.";
  }
}
---

<AdminLayout title="Admin — Extract Claims" description="Governed deterministic claim extraction for eligible feed items.">
  <div class="wrap" style="max-width:700px;">
    <h1>Extract Claims</h1>
    <p class="meta" style="margin-bottom:2rem;">
      <a href="/admin">← Admin home</a> · Deterministic rule-based extraction for the current bounded eligible queue.
    </p>

    {contextClusterId && (
      <section class="card" style="margin-bottom:1.25rem;background:var(--surface-2);">
        <p style="margin:0;">Opened from Review Queue for story cluster <strong>#{contextClusterId}</strong>. Extraction remains a bounded queue workflow; it is not limited to this story.</p>
        <p style="margin:0.5rem 0 0;"><a href={requestedReturnTo}>Return to Review Queue</a></p>
      </section>
    )}

    <section class="card" style="margin-bottom:2rem;">
      <h2 style="font-size:1.1rem;margin-bottom:0.55rem;">Run deterministic claim extraction</h2>
      <p>This scans up to 50 eligible feed items from the last 7 days that are clustered, classified, or published and have not completed the claim-extraction pipeline stage. Extraction is rule-based and has no AI dependency. Durable execution is publisher-only and goes through the signed admin endpoint.</p>
      {canExecuteExtraction ? (
        <form id="extract-form" data-extraction-form>
          <button type="submit" id="run-extraction-btn" class="btn btn-primary">Run deterministic extraction</button>
          <span id="extract-status" class="meta" role="status" aria-live="polite" style="margin-left:0.65rem;"></span>
        </form>
      ) : (
        <p class="meta" style="margin:0.75rem 0 0;">Reader access is read-only; a publisher must run durable extraction.</p>
      )}
    </section>

    <section id="extraction-result" class="card" aria-live="polite" style="display:none;margin-bottom:2rem;border-left:3px solid var(--ev-confirmed);"></section>

    <section id="extraction-audit" class="card" style="margin-bottom:2rem;">
      <details id="recent-extraction-runs">
        <summary style="cursor:pointer;font-weight:600;">Recent extraction runs</summary>
        <p id="extraction-runs-status" class="meta" style="margin-top:0.75rem;">Open to load the bounded read-only run audit.</p>
        <div id="extraction-runs-list"></div>
      </details>
    </section>

    {debugError && (
      <section class="card" style="margin-bottom:2rem;border-left:3px solid var(--ev-disputed);">
        <h2 style="font-size:1.1rem;margin-bottom:0.5rem;">Diagnostic Failed</h2>
        <p style="color:var(--ev-disputed);">{debugError}</p>
      </section>
    )}

    <section class="card" style="margin-bottom:2rem;background:var(--surface-2);">
      <h2 style="font-size:1.1rem;margin-bottom:0.55rem;">Read-only diagnostic preview</h2>
      <p>This samples three eligible items and runs the pure extractor in memory. It does not create canonical claims, assertions, evidence records, pipeline stages, or audit mutations.</p>
      <form method="POST" action={debugAction}>
        <button type="submit" class="btn" style="background:var(--bg-muted);">Diagnose — Sample 3 Items</button>
      </form>
    </section>

    {debugSamples.length > 0 && (
      <section class="card" style="margin-bottom:2rem;">
        <h2 style="font-size:1.1rem;margin-bottom:0.75rem;">Diagnostic Sample</h2>
        {debugSamples.map((sample) => (
          <div style="margin-bottom:1rem;padding-bottom:0.75rem;border-bottom:1px solid var(--border-light);">
            <p style="font-weight:600;font-size:0.85rem;">#{sample.id} — {sample.title} <span class="badge badge-sm">Tier {sample.sourceTier}</span></p>
            <p class="meta" style="font-size:0.7rem;margin-bottom:0.25rem;">Normalized length: {sample.textLen} chars · Claims found: <strong>{sample.claimCount}</strong></p>
            <details><summary style="font-size:0.7rem;cursor:pointer;">Raw text (first 300 chars)</summary>
              <pre style="font-size:0.65rem;white-space:pre-wrap;word-break:break-word;background:var(--bg-muted);padding:0.5rem;margin-top:0.25rem;max-height:120px;overflow-y:auto;">{sample.rawText}</pre>
            </details>
            <details><summary style="font-size:0.7rem;cursor:pointer;">Normalized text (first 300 chars)</summary>
              <pre style="font-size:0.65rem;white-space:pre-wrap;word-break:break-word;background:var(--bg-muted);padding:0.5rem;margin-top:0.25rem;max-height:120px;overflow-y:auto;">{sample.normalizedText}</pre>
            </details>
            {sample.claims.length > 0 && (
              <details><summary style="font-size:0.7rem;cursor:pointer;">Show claims</summary>
                <ul style="font-size:0.7rem;margin-top:0.25rem;">
                  {sample.claims.map((claim) => <li>{claim}</li>)}
                </ul>
              </details>
            )}
          </div>
        ))}
      </section>
    )}

    <p class="meta" style="font-size:0.75rem;">Durable run audit records selected items, terminal outcomes, deterministic claim candidates, newly inserted assertions, and successful canonical-writer calls. The legacy <code>evidenceCreated</code> response field is retained for compatibility and is not an evidence-row count.</p>
  </div>

  <script>
    interface ExtractionRunSummary {
      runId: string;
      trigger: "manual_admin" | "scheduler";
      algorithmVersion: string;
      requestId: string | null;
      operatorEmail: string | null;
      operatorRole: "reader" | "publisher" | null;
      startedAt: string;
      completedAt: string | null;
      status: "running" | "completed" | "completed_with_failures" | "failed" | "interrupted";
      selectedCount: number;
      processedCount: number;
      noClaimCount: number;
      failedCount: number;
      extractedClaimCount: number;
      newAssertionCount: number;
      canonicalWriteSuccessCount: number;
      failureCode: string | null;
      failureMessage: string | null;
      createdAt: string;
    }

    interface ExtractionRunEffect {
      effectId: number;
      effectOrdinal: number;
      claimText: string;
      claimClass: string;
      claimDomain: string;
      attemptOutcome: "inserted" | "reused" | "failed";
      canonicalClaimId: string | null;
      assertionId: string | null;
      canonicalClaimInserted: boolean | null;
      assertionInserted: boolean | null;
      storyClaimInserted: boolean | null;
      failureCode: string | null;
      failureMessage: string | null;
    }

    interface ExtractionRunItem {
      runItemId: number;
      feedItemId: number;
      ordinal: number;
      selectedAt: string;
      outcome: "pending" | "extracted" | "no_claims" | "failed";
      pipelineStageId: number | null;
      feedItemTitle: string;
      feedItemUrl: string;
      sourceName: string | null;
      extractedClaimCount: number;
      newAssertionCount: number;
      canonicalWriteSuccessCount: number;
      failureCode: string | null;
      failureMessage: string | null;
      completedAt: string | null;
      effects: ExtractionRunEffect[];
    }

    interface ExtractionRunDetail {
      run: ExtractionRunSummary;
      items: ExtractionRunItem[];
      reconciliation: {
        selectedCount: number;
        processedCount: number;
        noClaimCount: number;
        failedCount: number;
        extractedClaimCount: number;
        newAssertionCount: number;
        canonicalWriteSuccessCount: number;
        matchesStoredCounters: boolean;
      };
      itemLimit: number;
      effectLimit: number;
      itemsTruncated: boolean;
      effectsTruncated: boolean;
    }

    interface ExtractionRunsResponse {
      runs: ExtractionRunSummary[];
      limit: number;
      truncated: boolean;
    }

    const recentRunsDisclosure = document.getElementById("recent-extraction-runs") as HTMLDetailsElement | null;
    const runsStatus = document.getElementById("extraction-runs-status");
    const runsList = document.getElementById("extraction-runs-list");
    const loadedRunDetails = new Set<string>();
    let runsLoaded = false;

    function auditText(value: unknown, fallback = "—"): string {
      return value === null || value === undefined || value === "" ? fallback : String(value);
    }

    function addAuditLine(parent: HTMLElement, label: string, value: unknown): void {
      const line = document.createElement("p");
      line.style.margin = "0.3rem 0";
      const strong = document.createElement("strong");
      strong.textContent = `${label}: `;
      line.appendChild(strong);
      line.appendChild(document.createTextNode(auditText(value)));
      parent.appendChild(line);
    }

    function statusLabel(status: ExtractionRunSummary["status"]): string {
      return status === "completed_with_failures" ? "completed with failures"
        : status === "running" ? "in progress"
          : status === "interrupted" ? "did not record normal completion" : status;
    }

    function renderRunDetail(container: HTMLElement, detail: ExtractionRunDetail): void {
      container.replaceChildren();
      const run = detail.run;
      const metadata = document.createElement("div");
      metadata.style.margin = "0.75rem 0";
      addAuditLine(metadata, "Trigger", run.trigger === "scheduler" ? "Scheduler" : "Manual admin");
      addAuditLine(metadata, "Status", statusLabel(run.status));
      addAuditLine(metadata, "Started", run.startedAt);
      addAuditLine(metadata, "Completed", run.completedAt ?? "Run did not record normal completion");
      addAuditLine(metadata, "Algorithm", run.algorithmVersion);
      if (run.operatorEmail) addAuditLine(metadata, "Operator", `${run.operatorEmail} (${run.operatorRole ?? "admin"})`);
      if (run.failureMessage) addAuditLine(metadata, "Run failure", `${run.failureCode ?? "failure"}: ${run.failureMessage}`);
      container.appendChild(metadata);

      const counters = document.createElement("div");
      counters.style.padding = "0.65rem";
      counters.style.background = "var(--surface-2)";
      addAuditLine(counters, "Selected items", run.selectedCount);
      addAuditLine(counters, "Processed items", run.processedCount);
      addAuditLine(counters, "No-claim items", run.noClaimCount);
      addAuditLine(counters, "Failed items", run.failedCount);
      addAuditLine(counters, "Extracted claim candidates", run.extractedClaimCount);
      addAuditLine(counters, "New assertions", run.newAssertionCount);
      addAuditLine(counters, "Successful canonical-writer calls", run.canonicalWriteSuccessCount);
      container.appendChild(counters);

      const reconciliation = document.createElement("p");
      reconciliation.className = "meta";
      reconciliation.textContent = detail.reconciliation.matchesStoredCounters
        ? "Durable counters reconcile exactly from the persisted run-item and effect rows."
        : "The bounded detail response does not reconcile exactly with stored counters.";
      container.appendChild(reconciliation);
      if (detail.itemsTruncated || detail.effectsTruncated) {
        const truncation = document.createElement("p");
        truncation.className = "meta";
        truncation.textContent = `Audit detail is bounded to ${detail.itemLimit} items and ${detail.effectLimit} effects; the response is truncated.`;
        container.appendChild(truncation);
      }

      const itemsHeading = document.createElement("h4");
      itemsHeading.textContent = "Selected item outcomes";
      itemsHeading.style.margin = "1rem 0 0.5rem";
      container.appendChild(itemsHeading);
      for (const item of detail.items) {
        const itemDetails = document.createElement("details");
        itemDetails.style.margin = "0.35rem 0";
        const itemSummary = document.createElement("summary");
        itemSummary.style.cursor = "pointer";
        itemSummary.textContent = `#${item.ordinal + 1} · feed item ${item.feedItemId} · ${item.outcome}`;
        itemDetails.appendChild(itemSummary);
        const itemBody = document.createElement("div");
        itemBody.style.padding = "0.4rem 0.75rem";
        addAuditLine(itemBody, "Title", item.feedItemTitle);
        addAuditLine(itemBody, "Source", item.sourceName ?? "Unknown source");
        addAuditLine(itemBody, "Claim candidates", item.extractedClaimCount);
        addAuditLine(itemBody, "New assertions", item.newAssertionCount);
        addAuditLine(itemBody, "Canonical-writer calls", item.canonicalWriteSuccessCount);
        if (item.failureMessage) addAuditLine(itemBody, "Failure", `${item.failureCode ?? "failure"}: ${item.failureMessage}`);
        for (const effect of item.effects) {
          const effectLine = document.createElement("p");
          effectLine.style.margin = "0.3rem 0";
          effectLine.textContent = `Claim ${effect.effectOrdinal + 1}: ${effect.attemptOutcome} · “${effect.claimText}” · ${effect.claimDomain}/${effect.claimClass}`
            + (effect.assertionId ? ` · assertion ${effect.assertionId}` : "")
            + (effect.failureMessage ? ` · ${effect.failureMessage}` : "");
          itemBody.appendChild(effectLine);
        }
        itemDetails.appendChild(itemBody);
        container.appendChild(itemDetails);
      }
    }

    function renderRunList(data: ExtractionRunsResponse): void {
      if (!runsList || !runsStatus) return;
      runsList.replaceChildren();
      runsStatus.textContent = data.runs.length === 0
        ? "No durable extraction runs have been recorded yet."
        : `${data.runs.length} recent run${data.runs.length === 1 ? "" : "s"} shown.`;
      if (data.truncated) {
        const note = document.createElement("span");
        note.textContent = ` The list is bounded to ${data.limit}; older runs are not shown.`;
        runsStatus.appendChild(note);
      }
      for (const run of data.runs) {
        const runDetails = document.createElement("details");
        runDetails.style.margin = "0.65rem 0";
        const summary = document.createElement("summary");
        summary.style.cursor = "pointer";
        summary.textContent = `${run.trigger === "scheduler" ? "Scheduler" : "Manual admin"} · ${statusLabel(run.status)} · ${run.startedAt} · ${run.selectedCount} selected`;
        runDetails.appendChild(summary);
        const body = document.createElement("div");
        body.style.padding = "0.5rem 0.75rem";
        body.textContent = "Open to load durable run detail…";
        runDetails.appendChild(body);
        runDetails.addEventListener("toggle", async () => {
          if (!runDetails.open || loadedRunDetails.has(run.runId)) return;
          loadedRunDetails.add(run.runId);
          body.textContent = "Loading durable run detail…";
          try {
            const response = await fetch(`/api/admin/extraction-run?runId=${encodeURIComponent(run.runId)}`, { credentials: "include" });
            const detail = await response.json().catch(() => null) as ExtractionRunDetail | { error?: string } | null;
            if (!response.ok || !detail || !("run" in detail)) throw new Error((detail && "error" in detail && detail.error) || `Audit detail failed (HTTP ${response.status}).`);
            renderRunDetail(body, detail);
          } catch (error: unknown) {
            body.textContent = error instanceof Error ? error.message : "The durable run detail could not be loaded.";
          }
        });
        runsList.appendChild(runDetails);
      }
    }

    async function loadRecentRuns(): Promise<void> {
      if (runsLoaded || !runsStatus) return;
      runsLoaded = true;
      runsStatus.textContent = "Loading recent durable extraction runs…";
      try {
        const response = await fetch("/api/admin/extraction-runs", { credentials: "include" });
        const data = await response.json().catch(() => null) as ExtractionRunsResponse | { error?: string } | null;
        if (!response.ok || !data || !("runs" in data)) throw new Error((data && "error" in data && data.error) || `Run audit failed (HTTP ${response.status}).`);
        renderRunList(data);
      } catch (error: unknown) {
        runsStatus.textContent = error instanceof Error ? error.message : "The durable run audit could not be loaded.";
      }
    }

    recentRunsDisclosure?.addEventListener("toggle", () => {
      if (recentRunsDisclosure.open) void loadRecentRuns();
    });
  </script>

  {canExecuteExtraction && (
    <script>
      interface ExtractionResponse {
        status?: string;
        runId?: string;
        runStatus?: string;
        processed?: number;
        claimsExtracted?: number;
        evidenceCreated?: number;
        selectedCount?: number;
        processedCount?: number;
        noClaimCount?: number;
        failedCount?: number;
        extractedClaimCount?: number;
        newAssertionCount?: number;
        canonicalWriteSuccessCount?: number;
        error?: string;
      }

      const form = document.getElementById("extract-form") as HTMLFormElement | null;
      const button = document.getElementById("run-extraction-btn") as HTMLButtonElement | null;
      const status = document.getElementById("extract-status");
      const result = document.getElementById("extraction-result");
      const returnHref = "/admin/review";
      let submitting = false;

      function setStatus(message: string, isError = false): void {
        if (!status) return;
        status.textContent = message;
        status.style.color = isError ? "var(--ev-disputed)" : "var(--ev-confirmed)";
        status.setAttribute("role", isError ? "alert" : "status");
      }

      function renderResult(data: ExtractionResponse): void {
        if (!result) return;
        result.replaceChildren();
        result.style.display = "block";
        result.style.borderLeftColor = "var(--ev-confirmed)";
        const heading = document.createElement("h2");
        heading.style.fontSize = "1.1rem";
        heading.style.marginBottom = "0.5rem";
        const failed = data.runStatus === "completed_with_failures" || (data.failedCount ?? 0) > 0;
        if (failed) result.style.borderLeftColor = "var(--ev-disputed)";
        heading.textContent = failed ? "Extraction completed with failures" : "Last request result";
        result.appendChild(heading);
        for (const [value, label] of [
          [data.selectedCount, "items selected"],
          [data.processedCount, "items processed"],
          [data.noClaimCount, "items with no claims"],
          [data.failedCount, "items failed"],
          [data.extractedClaimCount, "claim candidates extracted"],
          [data.newAssertionCount, "new assertions"],
          [data.canonicalWriteSuccessCount, "successful canonical-writer calls"],
        ] as Array<[number | undefined, string]>) {
          const line = document.createElement("p");
          const strong = document.createElement("strong");
          strong.textContent = String(typeof value === "number" ? value : 0);
          line.appendChild(strong);
          line.appendChild(document.createTextNode(` ${label}`));
          result.appendChild(line);
        }
        if (data.runId) {
          const runLink = document.createElement("a");
          const auditUrl = new URL(window.location.href);
          auditUrl.searchParams.set("auditRunId", data.runId);
          auditUrl.hash = "extraction-audit";
          runLink.href = auditUrl.toString();
          runLink.textContent = `Open durable audit for run ${data.runId}`;
          result.appendChild(runLink);
        }
        if (data.processedCount === 0) {
          const note = document.createElement("p");
          note.className = "meta";
          note.textContent = "No eligible items were found in the current bounded queue.";
          result.appendChild(note);
        }
        const returnLink = document.createElement("a");
        returnLink.href = returnHref;
        returnLink.textContent = "Return to Review Queue";
        result.appendChild(returnLink);
      }

      form?.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (submitting || !button) return;
        submitting = true;
        button.disabled = true;
        button.textContent = "Running…";
        setStatus("Running deterministic extraction…");
        if (result) result.style.display = "none";
        try {
          const response = await fetch("/api/admin/extract-claims", {
            method: "POST",
            credentials: "include",
            headers: { "Content-Type": "application/json" },
            body: "{}",
          });
          if (response.status === 401 || response.status === 302 || response.type === "opaqueredirect") {
            throw new Error("Access session expired — reload the page.");
          }
          const data = await response.json().catch(() => ({})) as ExtractionResponse;
          if (!response.ok) throw new Error(data.error || `Extraction failed (HTTP ${response.status}).`);
          renderResult(data);
          const failed = data.runStatus === "completed_with_failures" || (data.failedCount ?? 0) > 0;
          setStatus(failed ? "Extraction completed with failures." : "Durable extraction completed.");
        } catch (error: unknown) {
          if (result) {
            result.replaceChildren();
            result.style.display = "block";
            result.style.borderLeftColor = "var(--ev-disputed)";
            const heading = document.createElement("h2");
            heading.style.fontSize = "1.1rem";
            heading.textContent = "Extraction failed";
            const message = document.createElement("p");
            message.style.color = "var(--ev-disputed)";
            message.textContent = error instanceof Error ? error.message : "The extraction workflow could not be confirmed.";
            result.appendChild(heading);
            result.appendChild(message);
          }
          setStatus("Extraction failed.", true);
          console.error(error);
        } finally {
          submitting = false;
          button.disabled = false;
          button.textContent = "Run deterministic extraction";
        }
      });
    </script>
  )}
</AdminLayout>
