---
import BaseLayout from "../../layouts/BaseLayout.astro";

export const prerender = false;

interface SourceRow {
  id: number; name: string; url: string; tier: string; treatment: string; ingestion_type: string;
  cadence_minutes: number; health_status: string; active: number; last_fetched_at: string | null;
  last_success_at: string | null; last_error_at: string | null; last_error_message: string | null;
  consecutive_failures: number;
}

interface UploadRow {
  id: string; display_filename: string; media_type: string; media_kind: string;
  content_hash: string; byte_length: number; outcome_state: string; state_reason: string | null;
  created_at: string; source_document_id: string | null; source_document_version_id: string | null;
  retrieval_state: string | null; extraction_state: string | null; storage_state: string | null;
}

let sources: SourceRow[] = [];
let loadError: string | null = null;
let uploads: UploadRow[] = [];
let uploadLoadError: string | null = null;
try {
  sources = (await Astro.locals.runtime.env.DB.prepare(`
    SELECT id, name, url, tier, treatment, ingestion_type, cadence_minutes, health_status,
           active, last_fetched_at, last_success_at, last_error_at, last_error_message, consecutive_failures
    FROM sources ORDER BY tier, name
  `).all<SourceRow>()).results;
} catch {
  loadError = "Source health is unavailable. Verify the D1 binding and schema migrations.";
}
try {
  uploads = (await Astro.locals.runtime.env.DB.prepare(`
    SELECT intake.id, intake.display_filename, intake.media_type, intake.media_kind,
           intake.content_hash, intake.byte_length, intake.outcome_state, intake.state_reason,
           intake.created_at, intake.source_document_id, intake.source_document_version_id,
           document.retrieval_state, version.extraction_state, version.storage_state
    FROM source_upload_intakes intake
    LEFT JOIN source_documents document ON document.id = intake.source_document_id
    LEFT JOIN source_document_versions version ON version.id = intake.source_document_version_id
    ORDER BY intake.created_at DESC, intake.id DESC LIMIT 25
  `).all<UploadRow>()).results;
} catch {
  uploadLoadError = "Document upload status is unavailable until the KC-03F/03G migration is applied.";
}

const implemented = new Set(["rss", "github_api", "arxiv_api", "hackernews_api"]);
const active = sources.filter((source) => Boolean(source.active));
const count = (status: string) => active.filter((source) => source.health_status === status).length;
const fmt = (value: string | null) => value ? new Date(value).toLocaleString("en-GB") : "Never";
const safeHttpUrl = (value: string): string | null => {
  try {
    const url = new URL(value);
    return (url.protocol === "https:" || url.protocol === "http:") && !url.username && !url.password ? url.href : null;
  } catch { return null; }
};
---

<BaseLayout title="Admin — Sources" description="Live source registry and connector health.">
  <div class="wrap">
    <h1>Admin: Sources</h1>
    <p class="meta" style="margin-bottom:2rem;"><a href="/admin/jobs">Jobs</a> · <a href="/admin/review">Review</a> · <a href="/admin">Admin home</a></p>

    <section class="card" style="margin-bottom:2rem;">
      <h2>Upload governed source document</h2>
      <p class="meta">Publisher-only server processing. UTF-8 plain text, Markdown, and ordinary HTML are extracted deterministically up to 2 MiB. PDFs up to 2 MiB are stored privately as opaque originals; text extraction is not enabled. Uploads remain private source material and never publish or become accepted evidence automatically.</p>
      <form id="source-upload-form" style="display:flex;gap:1rem;align-items:end;flex-wrap:wrap;margin-top:1rem;">
        <label style="display:grid;gap:0.35rem;">Document file<input id="source-upload-file" name="file" type="file" accept=".txt,.text,.md,.markdown,.html,.htm,.pdf,text/plain,text/markdown,text/html,application/xhtml+xml,application/pdf" required /></label>
        <button type="submit">Upload for governed extraction</button>
      </form>
      <p id="source-upload-result" class="meta" role="status" style="margin-top:1rem;"></p>
      {uploadLoadError ? <p class="meta">{uploadLoadError}</p> : <div style="overflow-x:auto;margin-top:1rem;">
        <table style="width:100%;border-collapse:collapse;font-size:0.82rem;">
          <thead><tr style="text-align:left;border-bottom:2px solid var(--border);"><th>File</th><th>Type</th><th>State</th><th>Source/version</th><th>Digest</th><th>Received</th></tr></thead>
          <tbody>
            {uploads.map((upload) => <tr style="vertical-align:top;border-bottom:1px solid var(--border);">
              <td>{upload.display_filename}<br /><span class="meta">{upload.byte_length.toLocaleString("en-GB")} bytes</span></td>
              <td><code>{upload.media_type}</code><br /><span class="meta">{upload.media_kind}</span></td>
              <td><span class={`badge badge-${upload.outcome_state === "extracted" ? "confirmed" : upload.outcome_state === "extraction_failed" ? "disputed" : "provisional"}`}>{upload.media_kind === "pdf" && upload.outcome_state === "extraction_pending" ? "PDF stored privately — text extraction not enabled" : upload.media_kind === "pdf" && upload.outcome_state === "metadata_only" ? "PDF metadata only" : upload.outcome_state}</span><br /><span class="meta">{upload.state_reason ?? upload.extraction_state ?? "—"}</span></td>
              <td class="meta">{upload.source_document_id ?? "—"}<br />{upload.source_document_version_id ?? "—"}<br />{upload.storage_state ?? "—"}</td>
              <td class="mono">{upload.content_hash.slice(0, 16)}…</td>
              <td class="meta">{fmt(upload.created_at)}</td>
            </tr>)}
            {uploads.length === 0 && <tr><td colspan="6" class="meta" style="padding:1rem;text-align:center;">No document uploads recorded.</td></tr>}
          </tbody>
        </table>
      </div>}
    </section>

    {loadError ? <div class="card"><p class="meta">{loadError}</p></div> : <>
      <section class="grid-3" style="margin-bottom:2rem;">
        <div class="card" style="text-align:center;"><p style="font-size:2rem;font-weight:700;">{active.length}</p><p class="meta">Active sources</p></div>
        <div class="card" style="text-align:center;"><p style="font-size:2rem;font-weight:700;color:var(--ev-disputed);">{count("degraded") + count("failing")}</p><p class="meta">Degraded or failing</p></div>
        <div class="card" style="text-align:center;"><p style="font-size:2rem;font-weight:700;color:var(--ev-provisional);">{active.filter((source) => !implemented.has(source.ingestion_type)).length}</p><p class="meta">Unsupported connectors</p></div>
      </section>

      <section>
        <h2>Registry and health</h2>
        <p class="meta">Times, connector support, and failures are read directly from D1. No synthetic health values are displayed.</p>
        <div style="overflow-x:auto;margin-top:1rem;">
          <table style="width:100%;border-collapse:collapse;font-size:0.82rem;">
            <thead><tr style="text-align:left;border-bottom:2px solid var(--border);"><th>Source</th><th>Tier</th><th>Connector</th><th>Status</th><th>Last success</th><th>Last observation</th><th>Failure detail</th></tr></thead>
            <tbody>
              {sources.map((source) => {
                const supported = implemented.has(source.ingestion_type);
                const status = !source.active ? "disabled" : !supported ? "unsupported" : source.health_status;
                const sourceUrl = safeHttpUrl(source.url);
                return <tr style="vertical-align:top;border-bottom:1px solid var(--border);">
                  <td>{sourceUrl ? <a href={sourceUrl} rel="noopener noreferrer">{source.name}</a> : source.name}<br /><span class="meta">{source.treatment}</span></td>
                  <td>{source.tier}</td><td><code>{source.ingestion_type}</code><br /><span class="meta">{source.cadence_minutes} min</span></td>
                  <td><span class={`badge badge-${status === "healthy" ? "confirmed" : status === "failing" ? "disputed" : "provisional"}`}>{status}</span></td>
                  <td class="meta">{fmt(source.last_success_at)}</td><td class="meta">{fmt(source.last_fetched_at)}</td>
                  <td class="meta">{!supported ? "No connector implementation; ingestion is skipped and reported." : source.last_error_message ?? "—"}</td>
                </tr>;
              })}
              {sources.length === 0 && <tr><td colspan="7" class="meta" style="padding:2rem;text-align:center;">No sources are configured.</td></tr>}
            </tbody>
          </table>
        </div>
      </section>
    </>}
  </div>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("#source-upload-form");
  const fileInput = document.querySelector<HTMLInputElement>("#source-upload-file");
  const result = document.querySelector<HTMLElement>("#source-upload-result");
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!fileInput?.files?.[0] || !result) return;
    result.textContent = "Uploading under the governed source boundary…";
    const body = new FormData();
    body.set("file", fileInput.files[0]);
    try {
      const response = await fetch("/api/admin/source-upload", {
        method: "POST",
        body,
        headers: { "Idempotency-Key": crypto.randomUUID() },
        credentials: "include",
      });
      const payload = await response.json() as { state?: string; reason?: string; sourceDocumentVersionId?: string; error?: string };
      if (!response.ok) throw new Error(payload.error ?? "Upload failed.");
      result.textContent = `${payload.state ?? "received"}${payload.reason ? ` — ${payload.reason}` : ""}. Version: ${payload.sourceDocumentVersionId ?? "metadata-only"}.`;
      window.setTimeout(() => window.location.reload(), 700);
    } catch (error) {
      result.textContent = error instanceof Error ? error.message : "Upload failed.";
    }
  });
</script>
