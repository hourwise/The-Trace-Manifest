---
import AdminLayout from "../../layouts/AdminLayout.astro";
import EvidenceBadge from "../../components/EvidenceBadge.astro";
import { listRecentlyReviewedClusters, listReviewQueueClusters } from "../../lib/server/review-queue";
import type { ReviewQueueCluster } from "../../lib/review-queue-contract";

export const prerender = false;
const editorialAIEnabled = Astro.locals.runtime.env.TRACE_AI_EDITORIAL_ENABLED === "true";

// All 10 evidence states with their meanings and review triggers
const evidenceStates = [
  { status: "confirmed", label: "Confirmed", desc: "Multiple independent primary sources confirm this information. High confidence.", triggersReview: false },
  { status: "strongly_supported", label: "Strongly Supported", desc: "Primary sources with corroboration strongly support this claim.", triggersReview: false },
  { status: "provisionally_supported", label: "Provisionally Supported", desc: "Available evidence supports this claim, but verification is incomplete.", triggersReview: true },
  { status: "vendor_reported", label: "Vendor-reported", desc: "Information originates from a vendor. Independent verification pending.", triggersReview: true },
  { status: "community_reported", label: "Community-reported", desc: "Information reported by the community. Awaiting primary-source confirmation.", triggersReview: true },
  { status: "disputed", label: "Disputed", desc: "Conflicting claims or evidence exist. Treat with caution.", triggersReview: true },
  { status: "unverified", label: "Unverified", desc: "This item has not yet been verified against primary or independent sources.", triggersReview: true },
  { status: "corrected", label: "Corrected", desc: "This item has been corrected. The original statement was inaccurate or incomplete.", triggersReview: false },
  { status: "superseded", label: "Superseded", desc: "A more recent item provides updated or more accurate information.", triggersReview: false },
  { status: "outdated", label: "Outdated", desc: "The information may no longer be current. Seek more recent sources.", triggersReview: true },
];

let pendingReviews: ReviewQueueCluster[] = [];
let recentReviews: ReviewQueueCluster[] = [];
let reviewLoadError: string | null = null;
try {
  const db = Astro.locals.runtime.env.DB;
  [pendingReviews, recentReviews] = await Promise.all([
    listReviewQueueClusters(db, { scope: "pending-review", limit: 50 }),
    listRecentlyReviewedClusters(db, 20),
  ]);
} catch {
  reviewLoadError = "Review data is unavailable. Verify the D1 binding and publication migration.";
}
---

<AdminLayout
  title="Admin — Review Queue"
  description="Manual review queue for high-impact claims, disputed stories, and corrections."
>
  <div class="wrap">
    <h1>Admin: Review Queue</h1>
    <p class="meta" style="margin-bottom:2rem;">
      <a href="/admin/sources">← Sources</a> &middot; <a href="/admin/jobs">Jobs</a> &middot; <a href="/admin">Admin home</a>
    </p>

    <p style="padding:0.75rem;background:var(--surface-2);border-radius:var(--radius);font-size:0.9rem;margin-bottom:2rem;">
      Items flagged for human review per <a href="/docs/adr/0004-human-review-boundary.md">ADR-0004</a>.
      The pipeline auto-flags items when: only Tier C sources report a story, a single non-Tier-A source reports,
      vendor claims conflict with independent findings, or story confidence is below threshold.
    </p>

    <!-- Publish a story — primary action, placed first for quick access -->
    <section style="margin-bottom:2.5rem;">
      <h2>Publish a Story</h2>
      <p class="meta" style="margin-bottom:1rem;">
        Select a draft cluster, write the editorial summary, and publish. Published stories appear on the public <a href="/feed">feed</a> and <a href="/">homepage</a>.
      </p>

      <!-- Cluster selector with filters -->
      <div class="card" style="margin-bottom:1.5rem;background:var(--surface-2);">
        <div style="display:flex;gap:0.5rem;align-items:flex-end;flex-wrap:wrap;">
          <div style="flex:1;min-width:200px;">
            <label for="cluster-select" style="font-size:0.85rem;font-weight:600;display:block;margin-bottom:0.35rem;">Story Cluster</label>
            <select id="cluster-select" style="width:100%;" disabled>
              <option value="">— Click Load to view reviewed data —</option>
            </select>
          </div>
          <button type="button" id="load-clusters-btn" class="btn btn-secondary" style="font-size:0.8rem;">Load Clusters</button>
        </div>
        <!-- Filter row -->
        <div style="display:flex;gap:0.6rem;align-items:center;flex-wrap:wrap;margin-top:0.6rem;font-size:0.75rem;">
          <label style="display:flex;align-items:center;gap:0.25rem;">Topic
            <select id="filter-topic" style="font-size:0.75rem;padding:0.2rem 0.3rem;" disabled>
              <option value="">All</option>
            </select>
          </label>
          <label style="display:flex;align-items:center;gap:0.25rem;">Sort
            <select id="filter-sort" style="font-size:0.75rem;padding:0.2rem 0.3rem;" disabled>
              <option value="newest">Newest first</option>
              <option value="oldest">Oldest first</option>
            </select>
          </label>
          <label style="display:flex;align-items:center;gap:0.25rem;cursor:pointer;">
            <input type="checkbox" id="filter-hide-dupes" disabled style="width:auto;" /> Hide duplicates
          </label>
          <label style="display:flex;align-items:center;gap:0.25rem;cursor:pointer;">
            <input type="checkbox" id="filter-manual-only" disabled style="width:auto;" /> Manual entries only
          </label>
          <label style="display:flex;align-items:center;gap:0.25rem;cursor:pointer;">
            <input type="checkbox" id="filter-auto-only" disabled style="width:auto;" /> Feed entries only
          </label>
        </div>
        <p class="meta" style="margin-top:0.35rem;font-size:0.75rem;" id="cluster-count"></p>
      </div>

      <!-- Source Material — appears when cluster selected -->
      <div id="source-material" class="card" style="margin-bottom:1.5rem;background:var(--surface-2);display:none;">
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.5rem;margin-bottom:0.75rem;">
          <h3 style="font-size:0.95rem;margin:0;">Source Material <span class="meta" style="font-weight:400;" id="source-count"></span></h3>
          <div style="display:flex;gap:0.5rem;">
            <button type="button" id="find-related-btn" class="btn btn-secondary" style="font-size:0.8rem;" disabled>🔍 Find Related</button>
            <button type="button" id="ai-analyze-btn" class="btn btn-secondary" style="font-size:0.8rem;" data-ai-enabled={String(editorialAIEnabled)} disabled>{editorialAIEnabled ? "🤖 AI Analyze" : "AI Analyze disabled"}</button>
          </div>
        </div>
        <div id="ai-result" style="display:none;margin-bottom:0.75rem;padding:0.75rem;background:color-mix(in oklch, var(--accent) 6%, transparent);border-radius:var(--radius);border-left:3px solid var(--accent);"></div>
        <div id="related-items" style="display:none;margin-bottom:0.75rem;padding:0.75rem;background:color-mix(in oklch, var(--accent) 6%, transparent);border-radius:var(--radius);border-left:3px solid var(--accent);max-height:300px;overflow-y:auto;"></div>
        <div id="source-list" style="display:flex;flex-direction:column;gap:0.75rem;max-height:400px;overflow-y:auto;"></div>
      </div>

      <!-- Canonical claims and evidence — appears only after a cluster is selected -->
      <section id="claims-evidence-panel" class="card" data-assertion-governance-role={Astro.locals.operator?.role === "publisher" ? "publisher" : "reader"} style="margin-bottom:1.5rem;background:var(--surface-2);display:none;">
        <div style="display:flex;justify-content:space-between;align-items:baseline;gap:0.75rem;flex-wrap:wrap;">
          <h3 style="font-size:0.95rem;margin:0;">Claims &amp; Evidence</h3>
          <span id="claims-evidence-summary" class="meta" style="font-size:0.75rem;"></span>
        </div>
        <div id="claims-evidence-body" style="margin-top:0.75rem;"></div>
      </section>

      <!-- Editorial fields -->
      <div class="card" style="margin-bottom:1.5rem;background:var(--surface-2);">
        <div style="display:flex;flex-direction:column;gap:1rem;">
          <div>
            <label for="pub-headline" style="font-size:0.85rem;font-weight:600;display:block;margin-bottom:0.25rem;">Headline <span class="meta" style="font-weight:400;">(optional — uses cluster title if blank)</span></label>
            <input type="text" id="pub-headline" placeholder="Override the auto-generated headline…" style="width:100%;" />
          </div>
          <div>
            <label for="pub-summary" style="font-size:0.85rem;font-weight:600;display:block;margin-bottom:0.25rem;">Summary <span style="color:var(--ev-disputed);">*required</span></label>
            <textarea id="pub-summary" rows="3" placeholder="A concise neutral summary of what happened. Min 20 characters." style="width:100%;resize:vertical;"></textarea>
          </div>
          <div>
            <label for="pub-analysis" style="font-size:0.85rem;font-weight:600;display:block;margin-bottom:0.25rem;">TRACE Editorial Analysis <span class="meta" style="font-weight:400;">(optional)</span></label>
            <textarea id="pub-analysis" rows="3" placeholder="Why this matters, what may be overstated, how it relates to earlier events." style="width:100%;resize:vertical;"></textarea>
          </div>
          <div>
            <label for="pub-why" style="font-size:0.85rem;font-weight:600;display:block;margin-bottom:0.25rem;">Why This Matters <span class="meta" style="font-weight:400;">(optional)</span></label>
            <input type="text" id="pub-why" placeholder="A one-line explanation of significance…" style="width:100%;" />
          </div>
          <div>
            <label for="pub-image" style="font-size:0.85rem;font-weight:600;display:block;margin-bottom:0.25rem;">Headline Image URL <span class="meta" style="font-weight:400;">(optional — auto-detected from feed if blank)</span></label>
            <input type="url" id="pub-image" placeholder="https://…" style="width:100%;" />
          </div>
        </div>
        <div style="margin-top:1rem;display:flex;gap:0.75rem;align-items:center;flex-wrap:wrap;">
          <button type="button" id="publish-btn" class="btn btn-primary" disabled>Publish Story</button>
          <button type="button" id="archive-btn" class="btn btn-secondary" style="font-size:0.8rem;" disabled>Archive (not news)</button>
          <span id="publish-status" class="meta"></span>
        </div>
      </div>

      <!-- Recent publishes -->
      <div class="card" style="background:var(--surface-2);">
        <h3 style="font-size:0.95rem;margin-bottom:0.5rem;">Recently Published</h3>
        <div id="recent-publishes" class="meta" style="font-size:0.8rem;">—</div>
      </div>
    </section>

    <!-- Pending review queue -->
    <section style="margin-bottom:2.5rem;">
      <h2>Pending Review</h2>
      {reviewLoadError ? <div class="card"><p class="meta">{reviewLoadError}</p></div> : pendingReviews.length === 0 ?
        <div class="card" style="text-align:center;padding:2rem;"><p class="meta">No items currently pending review.</p></div> :
        <div style="display:flex;flex-direction:column;gap:0.65rem;">{pendingReviews.map((item) =>
          <div class="card"><div style="display:flex;justify-content:space-between;gap:1rem;"><strong>#{item.id} {item.title}</strong><EvidenceBadge status={item.evidence_status} size="sm" /></div><p class="meta">{item.topic ?? "Uncategorised"} · {item.source_count} source{item.source_count === 1 ? "" : "s"} · {item.publication_status}</p></div>
        )}</div>}
    </section>

    <!-- Evidence state reference -->
    <section style="margin-bottom:2.5rem;">
      <h2>Evidence States Reference</h2>
      <p class="meta" style="margin-bottom:1rem;">
        The 10-state evidence system. Each state determines whether an item needs human review.
      </p>
      <div style="display:flex;flex-direction:column;gap:0.65rem;">
        {evidenceStates.map((state) => (
          <div class="card" style="display:flex;align-items:flex-start;gap:0.75rem;padding:0.75rem 1rem;">
            <EvidenceBadge status={state.status} size="sm" />
            <div style="flex:1;min-width:0;">
              <p style="font-size:0.85rem;margin:0;">{state.desc}</p>
              {state.triggersReview && (
                <span class="review-indicator" style="margin-top:0.35rem;">Needs Review</span>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Review criteria -->
    <section style="margin-bottom:2.5rem;">
      <h2>Review Criteria</h2>
      <p class="meta">The following require human review before publication (per ADR-0004):</p>
      <ul style="padding-left:1.5rem;margin-top:0.75rem;display:flex;flex-direction:column;gap:0.35rem;" class="meta">
        <li><strong>High-impact security claims</strong> — CVEs, vulnerabilities, advisories</li>
        <li><strong>Legal or regulatory claims</strong> — legislation, compliance requirements</li>
        <li><strong>Claims accusing organisations or individuals of misconduct</strong></li>
        <li><strong>Major benchmark conclusions</strong> — "best model" rankings</li>
        <li><strong>"Best model" or "best provider" rankings</strong> — must be evidence-grounded</li>
        <li><strong>Corrections affecting prominent stories</strong> — must follow correction workflow</li>
        <li><strong>Sponsored comparisons</strong> — must flag commercial interest</li>
        <li><strong>Claims based mainly on community reports</strong> — Tier C only clusters</li>
        <li><strong>Stories with strong contradictory evidence</strong> — conflict detected</li>
        <li><strong>Extraordinary-severity claims</strong> — automatic flag regardless of source</li>
      </ul>
    </section>

    <!-- Review history -->
    <section>
      <h2>Review History</h2>
      {recentReviews.length === 0 ? <div class="card" style="text-align:center;padding:2rem;"><p class="meta">No reviews have been completed yet.</p></div> :
        <div style="display:flex;flex-direction:column;gap:0.65rem;">{recentReviews.map((item) =>
          <div class="card"><strong>#{item.id} {item.title}</strong><p class="meta">{item.reviewed_by} · {item.reviewed_at ? new Date(item.reviewed_at).toLocaleString("en-GB") : "—"} · {item.publication_status}</p></div>
        )}</div>}
    </section>

    <script>
      import type { ReviewQueuePublishableCluster } from "../../lib/review-queue-contract";
      import type {
        EditorialAssertion,
        EditorialClaim,
        EditorialClusterEvidence,
        EditorialEvidenceAttachment,
      } from "../../lib/editorial-evidence-contract";
      import {
        ASSERTION_GOVERNANCE_REASON_MAX_LENGTH,
        buildAssertionGovernancePayload,
        createAssertionGovernanceIdempotencyKey,
        governanceDecisionMessage,
        governanceFailureMessage,
        shouldRefreshEvidenceAfterFailure,
        shouldRefreshPublishableClusters,
        shouldRenderAssertionGovernanceControls,
        type AssertionGovernanceAction,
        type AssertionGovernanceErrorBody,
        type AssertionGovernanceResponse,
      } from "../../lib/admin/assertion-governance-ui";

      function authHeaders(method: string = "GET"): Record<string, string> {
        // Only set Content-Type for requests with a body; adding it to GET
        // requests triggers a CORS preflight that fails when Cloudflare Access
        // redirects to its login page after session expiry.
        return method === "GET" ? {} : { "Content-Type": "application/json" };
      }

      async function adminFetch(url: string, options: RequestInit = {}): Promise<Response> {
        const res = await fetch(url, { ...options, credentials: "include", headers: { ...authHeaders(options.method ?? "GET"), ...(options.headers as Record<string, string> ?? {}) } });
        if (res.status === 401 || res.status === 302 || res.type === "opaqueredirect") {
          // Session expired — ask the operator to reload the page through Access
          status("Session expired. Reload the page to re-authenticate.", true);
          throw new Error("Access session expired — reload the page.");
        }
        return res;
      }

      function status(msg: string, isError: boolean): void {
        const el = document.getElementById("publish-status");
        if (el) { el.textContent = msg; el.style.color = isError ? "var(--ev-disputed)" : "var(--ev-confirmed)"; }
      }

      // Helper: typed getElementById
      function $<T>(id: string): T | null {
        return document.getElementById(id) as T | null;
      }

      function escapeHTML(value: string): string {
        const element = document.createElement("div");
        element.textContent = value;
        return element.innerHTML;
      }

      function safeExternalUrl(value: string): string {
        try {
          const url = new URL(value, window.location.origin);
          return (url.protocol === "http:" || url.protocol === "https:") && !url.username && !url.password ? url.href : "#";
        } catch {
          return "#";
        }
      }

      function errorMessage(error: unknown, fallback: string): string {
        return error instanceof Error && error.message ? error.message : fallback;
      }

      // Load clusters with filtering
      let allClusters: ReviewQueuePublishableCluster[] = [];
      let clusterDetail: Record<number, { summary?: string | null; why?: string | null }> = {};

      interface PreservedClusterSelection {
        value: string;
        label: string;
      }

      function applyClusterFilters(preservedSelection?: PreservedClusterSelection): void {
        const select = $<HTMLSelectElement>("cluster-select");
        const count = document.getElementById("cluster-count");
        if (!select || !count) return;

        const topicFilter = $<HTMLSelectElement>("filter-topic")?.value ?? "";
        const sortOrder = $<HTMLSelectElement>("filter-sort")?.value ?? "newest";
        const hideDupes = $<HTMLInputElement>("filter-hide-dupes")?.checked ?? false;
        const manualOnly = $<HTMLInputElement>("filter-manual-only")?.checked ?? false;
        const autoOnly = $<HTMLInputElement>("filter-auto-only")?.checked ?? false;

        let filtered = [...allClusters];

        // Topic filter
        if (topicFilter) {
          filtered = filtered.filter(c => (c.topic ?? "uncategorised") === topicFilter);
        }

        // Manual/auto filter (approximate: clusters with 1 source and no topic tend to be manual entries)
        if (manualOnly) {
          filtered = filtered.filter(c => c.source_count <= 1 && !c.topic);
        }
        if (autoOnly) {
          filtered = filtered.filter(c => c.source_count > 1 || !!c.topic);
        }

        // Hide duplicate titles
        if (hideDupes) {
          const seen = new Set<string>();
          filtered = filtered.filter(c => {
            const key = c.title.toLowerCase().slice(0, 40);
            if (seen.has(key)) return false;
            seen.add(key);
            return true;
          });
        }

        // Sort
        if (sortOrder === "oldest") {
          filtered.sort((a, b) => new Date(a.created_at).getTime() - new Date(b.created_at).getTime());
        } else {
          filtered.sort((a, b) => new Date(b.created_at).getTime() - new Date(a.created_at).getTime());
        }

        // Render
        const currentValue = preservedSelection?.value ?? select.value;
        const currentLabel = preservedSelection?.label ?? select.options[select.selectedIndex]?.textContent ?? "Selected cluster";
        select.innerHTML = '<option value="">— Select a cluster —</option>';
        filtered.forEach((c) => {
          const opt = document.createElement("option");
          opt.value = String(c.id);
          const meta = c.source_names.length > 0 ? ` — ${c.source_names.slice(0, 3).join(", ")}` : "";
          const dateStr = c.created_at ? ` ${new Date(c.created_at).toLocaleDateString("en-GB")}` : "";
          opt.textContent = `#${c.id}: ${c.title.slice(0, 70)} [${c.publication_status}] (${c.source_count || 0}s${meta})${dateStr}`;
          select.appendChild(opt);
        });
        const selectedClusterStillListed = filtered.some(c => String(c.id) === currentValue);
        const selectedClusterStillPublishable = allClusters.some(c => String(c.id) === currentValue);
        if (currentValue && selectedClusterStillListed) {
          select.value = currentValue;
        } else if (currentValue && !selectedClusterStillPublishable) {
          const preserved = document.createElement("option");
          preserved.value = currentValue;
          preserved.textContent = `${currentLabel} (no longer publishable — evidence retained)`;
          preserved.dataset.preservedSelection = "true";
          select.appendChild(preserved);
          select.value = currentValue;
        }
        const drafts = filtered.filter(c => c.publication_status === 'draft').length;
        count.textContent = `${filtered.length} of ${allClusters.length} clusters shown. ${drafts} drafts.`;
        checkPublishReady();
      }

      async function loadPublishableClusters(preserveSelection = false, announce = true): Promise<boolean> {
        const select = $<HTMLSelectElement>("cluster-select");
        const count = document.getElementById("cluster-count");
        if (!select || !count) return false;

        const preservedSelection = preserveSelection && select.value
          ? { value: select.value, label: select.options[select.selectedIndex]?.textContent ?? "Selected cluster" }
          : undefined;

        select.disabled = true;
        if (!preserveSelection) select.innerHTML = '<option value="">Loading…</option>';
        if (announce) status("Loading clusters…", false);

        try {
          const res = await adminFetch(`/api/admin/clusters?scope=publishable&limit=200`);
          if (!res.ok) { throw new Error(`HTTP ${res.status}`); }
          allClusters = await res.json() as ReviewQueuePublishableCluster[];

          clusterDetail = {};
          allClusters.forEach((c) => {
            clusterDetail[c.id] = { summary: c.summary, why: c.why_it_matters };
          });

          if (allClusters.length > 0) {
            // Populate topic filter
            const topicSelect = $<HTMLSelectElement>("filter-topic");
            if (topicSelect) {
              const topics = new Set(allClusters.map(c => c.topic ?? "uncategorised").filter(Boolean));
              topicSelect.innerHTML = '<option value="">All</option>';
              [...topics].sort().forEach(t => {
                const opt = document.createElement("option");
                opt.value = t; opt.textContent = t;
                topicSelect.appendChild(opt);
              });
            }
          }

          // Enable filters
          $<HTMLSelectElement>("filter-topic")!.disabled = false;
          $<HTMLSelectElement>("filter-sort")!.disabled = false;
          $<HTMLInputElement>("filter-hide-dupes")!.disabled = false;
          $<HTMLInputElement>("filter-manual-only")!.disabled = false;
          $<HTMLInputElement>("filter-auto-only")!.disabled = false;
          select.disabled = false;

          applyClusterFilters(preservedSelection);
          if (announce) status(`Loaded ${allClusters.length} clusters.`, false);
          return true;
        } catch (e) {
          if (!preserveSelection) select.innerHTML = '<option value="">— Error loading —</option>';
          select.disabled = false;
          if (count) count.textContent = "";
          if (announce) status("Failed to load. Check your Access role and network.", true);
          console.error(e);
          return false;
        }
      }

      $<HTMLButtonElement>("load-clusters-btn")?.addEventListener("click", () => {
        void loadPublishableClusters();
      });

      // Re-filter on any filter change
      $<HTMLSelectElement>("filter-topic")?.addEventListener("change", () => applyClusterFilters());
      $<HTMLSelectElement>("filter-sort")?.addEventListener("change", () => applyClusterFilters());
      $<HTMLInputElement>("filter-hide-dupes")?.addEventListener("change", () => applyClusterFilters());
      $<HTMLInputElement>("filter-manual-only")?.addEventListener("change", function() {
        if (this.checked) { const cb = $<HTMLInputElement>("filter-auto-only"); if (cb) cb.checked = false; }
        applyClusterFilters();
      });
      $<HTMLInputElement>("filter-auto-only")?.addEventListener("change", function() {
        if (this.checked) { const cb = $<HTMLInputElement>("filter-manual-only"); if (cb) cb.checked = false; }
        applyClusterFilters();
      });

      // Enable publish button when cluster selected and summary has content
      function checkPublishReady(): void {
        const btn = $<HTMLButtonElement>("publish-btn");
        const archBtn = $<HTMLButtonElement>("archive-btn");
        const select = $<HTMLSelectElement>("cluster-select");
        const summary = $<HTMLTextAreaElement>("pub-summary");
        if (btn && select && summary) {
          const selectedClusterIsPublishable = allClusters.some((cluster) => String(cluster.id) === select.value);
          btn.disabled = !selectedClusterIsPublishable || !summary.value || summary.value.trim().length < 20;
        }
        if (archBtn && select) {
          archBtn.disabled = !select.value;
        }
      }
      $<HTMLSelectElement>("cluster-select")?.addEventListener("change", checkPublishReady);
      $<HTMLTextAreaElement>("pub-summary")?.addEventListener("input", checkPublishReady);

      // Load source material when cluster is selected
      let currentSources: Array<{ title: string; excerpt: string | null }> = [];
      let evidenceRequestToken = 0;
      const canGovernAssertions = document.getElementById("claims-evidence-panel")?.dataset.assertionGovernanceRole === "publisher";
      const assertionGovernanceRole = canGovernAssertions ? "publisher" as const : "reader" as const;
      let currentEditorialEvidence: EditorialClusterEvidence | null = null;

      interface AssertionGovernanceDraft {
        action: AssertionGovernanceAction;
        reason: string;
        idempotencyKey: string;
        submitting: boolean;
        hasAttemptedSubmission: boolean;
      }

      const assertionGovernanceDrafts = new Map<string, AssertionGovernanceDraft>();

      function governanceDomSuffix(assertionId: string): string {
        return assertionId.replace(/[^a-zA-Z0-9_-]/g, "-") || "assertion";
      }

      function assertionFromCurrentEvidence(assertionId: string): EditorialAssertion | null {
        for (const claim of currentEditorialEvidence?.claims ?? []) {
          const assertion = claim.assertions.find((candidate) => candidate.assertionId === assertionId);
          if (assertion) return assertion;
        }
        return null;
      }

      function disposeAssertionGovernanceDrafts(): void {
        assertionGovernanceDrafts.clear();
      }

      function setGovernanceFormMessage(assertionId: string, message: string, isError = false): void {
        const root = [...document.querySelectorAll<HTMLElement>("[data-assertion-governance]")]
          .find((candidate) => candidate.dataset.assertionId === assertionId);
        const messageEl = root?.querySelector<HTMLElement>("[data-governance-status]");
        if (messageEl) {
          messageEl.textContent = message;
          messageEl.style.color = isError ? "var(--ev-disputed)" : "var(--ev-confirmed)";
          messageEl.setAttribute("role", isError ? "alert" : "status");
        }
      }

      function setGovernanceFormBusy(assertionId: string, busy: boolean): void {
        const root = [...document.querySelectorAll<HTMLElement>("[data-assertion-governance]")]
          .find((candidate) => candidate.dataset.assertionId === assertionId);
        if (!root) return;
        root.querySelectorAll<HTMLButtonElement>("button").forEach((button) => { button.disabled = busy; });
        const textarea = root.querySelector<HTMLTextAreaElement>("textarea");
        if (textarea) textarea.disabled = busy;
        const submit = root.querySelector<HTMLButtonElement>("[data-governance-submit]");
        if (submit && busy) submit.textContent = "Saving…";
        if (submit && !busy) {
          const draft = assertionGovernanceDrafts.get(assertionId);
          if (draft) submit.textContent = `Confirm ${draft.action}`;
        }
      }

      function governanceControlsMarkup(assertion: EditorialAssertion): string {
        if (!shouldRenderAssertionGovernanceControls(assertionGovernanceRole, assertion.admissionState)) return "";
        const assertionId = escapeHTML(assertion.assertionId);
        const suffix = governanceDomSuffix(assertion.assertionId);
        const draft = assertionGovernanceDrafts.get(assertion.assertionId);
        if (!draft) {
          return `
            <div data-assertion-governance data-assertion-id="${assertionId}" style="margin-top:0.7rem;padding:0.65rem;background:var(--surface-2);border-left:3px solid var(--accent);">
              <p class="meta" style="margin:0 0 0.45rem;font-size:0.75rem;">Publisher admission control. A reason is required; this only governs admission, not reviewer state or freshness.</p>
              <div role="group" aria-label="Publisher admission controls for assertion ${assertionId}" style="display:flex;gap:0.5rem;flex-wrap:wrap;">
                <button type="button" class="btn btn-primary" data-governance-action="admit" data-assertion-id="${assertionId}" style="font-size:0.78rem;">Admit assertion</button>
                <button type="button" class="btn btn-secondary" data-governance-action="reject" data-assertion-id="${assertionId}" style="font-size:0.78rem;">Reject assertion</button>
              </div>
            </div>
          `;
        }
        const actionLabel = draft.action === "admit" ? "Admit assertion" : "Reject assertion";
        const explanation = draft.action === "admit"
          ? "Admission does not automatically mark the assertion editorially accepted or current."
          : "Rejection is an admission-layer decision; it does not delete or rewrite assertion history.";
        const reasonId = `assertion-governance-reason-${suffix}`;
        const hintId = `assertion-governance-hint-${suffix}`;
        const statusId = `assertion-governance-status-${suffix}`;
        return `
          <div data-assertion-governance data-assertion-id="${assertionId}" style="margin-top:0.7rem;padding:0.7rem;background:var(--surface-2);border-left:3px solid var(--accent);">
            <form data-governance-form data-assertion-id="${assertionId}" aria-label="${actionLabel} with a human reason">
              <p style="margin:0 0 0.45rem;font-size:0.78rem;"><strong>${actionLabel}</strong> — ${explanation}</p>
              <label for="${reasonId}" style="display:block;font-size:0.78rem;font-weight:600;margin-bottom:0.25rem;">Human reason <span class="meta" style="font-weight:400;">(required)</span></label>
              <textarea id="${reasonId}" rows="3" maxlength="${ASSERTION_GOVERNANCE_REASON_MAX_LENGTH}" aria-required="true" aria-describedby="${hintId}" data-governance-reason style="width:100%;resize:vertical;">${escapeHTML(draft.reason)}</textarea>
              <p id="${hintId}" class="meta" style="margin:0.25rem 0 0;font-size:0.72rem;">${draft.reason.length}/${ASSERTION_GOVERNANCE_REASON_MAX_LENGTH} characters. The reason is trimmed before it is sent.</p>
              <div style="display:flex;gap:0.5rem;align-items:center;flex-wrap:wrap;margin-top:0.55rem;">
                <button type="submit" class="btn btn-primary" data-governance-submit style="font-size:0.78rem;">Confirm ${draft.action}</button>
                <button type="button" class="btn btn-secondary" data-governance-cancel style="font-size:0.78rem;">Cancel</button>
              </div>
              <p id="${statusId}" data-governance-status class="meta" role="status" aria-live="polite" style="margin:0.45rem 0 0;font-size:0.75rem;"></p>
            </form>
          </div>
        `;
      }

      function displayState(value: string | null | undefined): string {
        return (value ?? "not recorded").replaceAll("_", " ");
      }

      function plural(count: number, singular: string, pluralForm = `${singular}s`): string {
        return `${count} ${count === 1 ? singular : pluralForm}`;
      }

      function assertionPosture(relationship: string): { label: string; style: string } {
        if (["supports", "partially_supports", "reproduces"].includes(relationship)) {
          return { label: "Supporting", style: "color:var(--ev-confirmed);" };
        }
        if (["contradicts", "fails_to_reproduce"].includes(relationship)) {
          return { label: "Disputing", style: "color:var(--ev-disputed);" };
        }
        return { label: "Context / qualification", style: "color:var(--muted);" };
      }

      function sourceMarkup(source: EditorialAssertion["source"] | EditorialEvidenceAttachment["source"]): string {
        if (!source) return '<span class="meta">Source unavailable in canonical record.</span>';
        const sourceLabel = `${escapeHTML(source.name)}${source.tier ? ` · Tier ${escapeHTML(source.tier)}` : ""}`;
        const link = source.url
          ? `<a href="${escapeHTML(safeExternalUrl(source.url))}" target="_blank" rel="noopener">Open authoritative source</a>`
          : '<span class="meta">No safe source URL recorded.</span>';
        const dates = [
          source.publishedAt ? `published ${escapeHTML(source.publishedAt)}` : "",
          source.retrievedAt ? `retrieved ${escapeHTML(source.retrievedAt)}` : "",
        ].filter(Boolean).join(" · ");
        return `<span>${sourceLabel}</span> · ${link}${dates ? ` · <span class="meta">${dates}</span>` : ""}`;
      }

      function assertionMarkup(assertion: EditorialAssertion): string {
        const posture = assertionPosture(assertion.relationship);
        const provenance = assertion.provenance
          ? `<div class="meta" style="margin-top:0.35rem;"><strong>Provenance:</strong> ${escapeHTML(displayState(assertion.provenance.originType))} · ${escapeHTML(assertion.provenance.explanation)} <span>(group ${escapeHTML(assertion.provenance.groupId)})</span></div>`
          : '<div class="meta" style="margin-top:0.35rem;"><strong>Provenance:</strong> not recorded</div>';
        const document = assertion.sourceDocument
          ? `<div class="meta" style="margin-top:0.35rem;"><strong>Source record:</strong> ${escapeHTML(assertion.sourceDocument.versionId)} · admission ${escapeHTML(displayState(assertion.sourceDocument.admissionState))}${assertion.sourceDocument.startLocator || assertion.sourceDocument.endLocator ? ` · locator ${escapeHTML([assertion.sourceDocument.startLocator, assertion.sourceDocument.endLocator].filter(Boolean).join("–"))}` : ""}</div>`
          : '<div class="meta" style="margin-top:0.35rem;"><strong>Source record:</strong> unavailable</div>';
        return `
          <details style="padding:0.45rem 0;border-bottom:1px solid var(--border-light);">
            <summary style="cursor:pointer;display:flex;gap:0.45rem;align-items:baseline;flex-wrap:wrap;">
              <span class="badge" style="font-size:0.63rem;${posture.style}">${posture.label}</span>
              <strong>${escapeHTML(displayState(assertion.relationship))}</strong>
              <span class="meta">${escapeHTML(displayState(assertion.admissionState))} · ${escapeHTML(displayState(assertion.freshnessState))} · ${escapeHTML(displayState(assertion.reviewerState))}</span>
            </summary>
            <p style="margin:0.5rem 0 0;font-size:0.82rem;line-height:1.45;">${escapeHTML(assertion.text)}</p>
            <div class="meta" style="margin-top:0.35rem;"><strong>Source:</strong> ${sourceMarkup(assertion.source)}</div>
            <div class="meta" style="margin-top:0.35rem;"><strong>Evidence treatment:</strong> ${escapeHTML(displayState(assertion.evidenceTreatment))} · <strong>directness:</strong> ${escapeHTML(displayState(assertion.directness))} · <strong>confidence:</strong> ${escapeHTML(String(assertion.confidence))}</div>
            ${document}
            ${provenance}
            ${governanceControlsMarkup(assertion)}
          </details>
        `;
      }

      function attachmentMarkup(attachment: EditorialEvidenceAttachment): string {
        return `
          <div style="padding:0.45rem 0;border-bottom:1px solid var(--border-light);font-size:0.82rem;">
            <div style="display:flex;gap:0.45rem;align-items:baseline;flex-wrap:wrap;">
              <span class="badge" style="font-size:0.63rem;">${escapeHTML(displayState(attachment.eligibilityState))}</span>
              <strong>${escapeHTML(displayState(attachment.relationship))}</strong>
              <span class="meta">reviewed ${escapeHTML(attachment.reviewedAt)} by ${escapeHTML(attachment.reviewedBy)}</span>
            </div>
            <div class="meta" style="margin-top:0.3rem;"><strong>Source:</strong> ${sourceMarkup(attachment.source)}</div>
            <div class="meta" style="margin-top:0.3rem;"><strong>Eligibility reason:</strong> ${escapeHTML(attachment.eligibilityReason)}</div>
            ${attachment.explanation ? `<div class="meta" style="margin-top:0.3rem;"><strong>Review note:</strong> ${escapeHTML(attachment.explanation)}</div>` : ""}
          </div>
        `;
      }

      function claimMarkup(claim: EditorialClaim, index: number): string {
        const noAdmitted = claim.assertionCount > 0 && claim.admittedAssertionCount === 0;
        const assertionSection = claim.assertionCount === 0
          ? '<p class="meta" style="margin:0.4rem 0 0;">No assertions are currently mapped to this claim.</p>'
          : `<div style="margin-top:0.5rem;">${claim.assertions.map(assertionMarkup).join("")}</div>${claim.assertionsTruncated ? `<p class="meta" style="margin:0.45rem 0 0;">Showing ${claim.assertions.length} of ${claim.assertionCount} assertions.</p>` : ""}`;
        const attachmentSection = claim.attachmentCount === 0
          ? '<p class="meta" style="margin:0.4rem 0 0;">No story evidence attachments are recorded for this claim.</p>'
          : `<div style="margin-top:0.5rem;">${claim.attachments.map(attachmentMarkup).join("")}</div>${claim.attachmentsTruncated ? `<p class="meta" style="margin:0.45rem 0 0;">Showing ${claim.attachments.length} of ${claim.attachmentCount} evidence attachments.</p>` : ""}`;
        return `
          <details open style="padding:0.65rem 0;border-top:1px solid var(--border-light);">
            <summary style="cursor:pointer;display:flex;gap:0.45rem;align-items:baseline;flex-wrap:wrap;">
              <strong>Claim ${index + 1}</strong>
              <span class="meta">${escapeHTML(displayState(claim.claimState))} · ${escapeHTML(displayState(claim.materiality))} · ${escapeHTML(displayState(claim.role))}</span>
              <span class="badge" style="font-size:0.63rem;">${escapeHTML(displayState(claim.evidenceStatus))}</span>
            </summary>
            <p style="margin:0.55rem 0 0;font-size:0.9rem;line-height:1.45;">${escapeHTML(claim.text)}</p>
            <p class="meta" style="margin:0.45rem 0 0;">Canonical claim <code>${escapeHTML(claim.canonicalClaimId)}</code> · ${plural(claim.assertionCount, "assertion")} · ${plural(claim.admittedAssertionCount, "admitted assertion")} · ${plural(claim.eligibleAttachmentCount, "eligible attachment")}${claim.score === null ? " · no score snapshot" : ` · score ${escapeHTML(String(claim.score))}`}</p>
            ${noAdmitted ? '<p class="meta" style="margin:0.4rem 0 0;color:var(--ev-disputed);">Claims exist but no admitted assertions are present.</p>' : ""}
            <h4 style="font-size:0.8rem;margin:0.7rem 0 0.1rem;">Assertions</h4>
            ${assertionSection}
            <h4 style="font-size:0.8rem;margin:0.8rem 0 0.1rem;">Evidence attachments</h4>
            ${attachmentSection}
          </details>
        `;
      }

      function beginAssertionGovernance(assertionId: string, action: AssertionGovernanceAction): void {
        if (!canGovernAssertions || assertionGovernanceDrafts.has(assertionId)) return;
        try {
          assertionGovernanceDrafts.set(assertionId, {
            action,
            reason: "",
            idempotencyKey: createAssertionGovernanceIdempotencyKey(),
            submitting: false,
            hasAttemptedSubmission: false,
          });
          if (currentEditorialEvidence) renderEditorialEvidence(currentEditorialEvidence);
          window.setTimeout(() => {
            const root = [...document.querySelectorAll<HTMLElement>("[data-assertion-governance]")]
              .find((candidate) => candidate.dataset.assertionId === assertionId);
            root?.querySelector<HTMLTextAreaElement>("textarea")?.focus();
          }, 0);
        } catch (error: unknown) {
          status(errorMessage(error, "Could not create a safe action key."), true);
        }
      }

      async function submitAssertionGovernance(assertionId: string): Promise<void> {
        const draft = assertionGovernanceDrafts.get(assertionId);
        const clusterId = currentEditorialEvidence?.clusterId;
        const assertion = assertionFromCurrentEvidence(assertionId);
        if (!draft || draft.submitting || !clusterId || !assertion) return;

        let payload: ReturnType<typeof buildAssertionGovernancePayload>;
        try {
          payload = buildAssertionGovernancePayload(clusterId, assertion, draft.action, draft.reason, draft.idempotencyKey);
        } catch (error: unknown) {
          const message = errorMessage(error, "Enter a valid human reason before submitting.");
          setGovernanceFormMessage(assertionId, message, true);
          status(message, true);
          return;
        }

        draft.submitting = true;
        draft.hasAttemptedSubmission = true;
        setGovernanceFormBusy(assertionId, true);
        setGovernanceFormMessage(assertionId, "Saving this admission decision…", false);
        status(`${draft.action === "admit" ? "Admitting" : "Rejecting"} assertion…`, false);

        try {
          const res = await adminFetch("/api/admin/assertion-review", {
            method: "POST",
            body: JSON.stringify(payload),
          });
          const raw = await res.json().catch(() => ({})) as AssertionGovernanceResponse | AssertionGovernanceErrorBody;

          if (!res.ok) {
            const errorBody = raw as AssertionGovernanceErrorBody;
            const reference = errorBody.eventId || errorBody.requestId ? ` Reference ${errorBody.eventId || errorBody.requestId}.` : "";
            const message = `${governanceFailureMessage(res.status, errorBody.code, errorBody.error || `HTTP ${res.status}`)}${reference}`;
            if (res.status === 503) {
              draft.submitting = false;
              setGovernanceFormBusy(assertionId, false);
              setGovernanceFormMessage(assertionId, `${message} Retry, if needed, with this same form and request key.`, true);
              status(message, true);
              return;
            }

            assertionGovernanceDrafts.delete(assertionId);
            if (shouldRefreshEvidenceAfterFailure(errorBody.code)) {
              await loadEditorialEvidence(clusterId);
            } else if (currentEditorialEvidence) {
              renderEditorialEvidence(currentEditorialEvidence);
            }
            status(message, true);
            return;
          }

          if ((raw as { success?: boolean }).success !== true) {
            throw new Error("The admission response was not recognised.");
          }
          const response = raw as AssertionGovernanceResponse;
          assertionGovernanceDrafts.delete(assertionId);
          const evidenceRefreshed = await loadEditorialEvidence(clusterId);
          const listRefreshed = !shouldRefreshPublishableClusters(response)
            || await loadPublishableClusters(true, false);
          let message = governanceDecisionMessage(response);
          if (!evidenceRefreshed) message += " The decision was recorded, but the selected evidence could not be refreshed.";
          if (!listRefreshed) message += " The publishable cluster list could not be refreshed; reload it before publishing.";
          focusEditorialEvidenceSummary();
          status(message, !evidenceRefreshed || !listRefreshed);
        } catch (error: unknown) {
          const sessionExpired = error instanceof Error && error.message.includes("Access session expired");
          if (sessionExpired) {
            draft.submitting = false;
            setGovernanceFormBusy(assertionId, false);
            setGovernanceFormMessage(assertionId, "Session expired. Reload the page to re-authenticate before trying again.", true);
            status("Session expired. Reload the page to re-authenticate.", true);
            return;
          }
          const message = governanceFailureMessage(503, undefined, errorMessage(error, "The request could not be confirmed."));
          draft.submitting = false;
          setGovernanceFormBusy(assertionId, false);
          setGovernanceFormMessage(assertionId, `${message} The same request key remains available for a cautious retry.`, true);
          status(message, true);
          console.error(error);
        } finally {
          const activeDraft = assertionGovernanceDrafts.get(assertionId);
          if (activeDraft === draft && !activeDraft.submitting) setGovernanceFormBusy(assertionId, false);
        }
      }

      function bindAssertionGovernanceControls(): void {
        const body = $<HTMLElement>("claims-evidence-body");
        if (!body) return;
        body.querySelectorAll<HTMLButtonElement>("[data-governance-action]").forEach((button) => {
          button.addEventListener("click", () => {
            const assertionId = button.dataset.assertionId;
            const action = button.dataset.governanceAction as AssertionGovernanceAction | undefined;
            if (assertionId && (action === "admit" || action === "reject")) beginAssertionGovernance(assertionId, action);
          });
        });
        body.querySelectorAll<HTMLButtonElement>("[data-governance-cancel]").forEach((button) => {
          button.addEventListener("click", () => {
            const form = button.closest<HTMLElement>("[data-assertion-governance]");
            const assertionId = form?.dataset.assertionId;
            if (!assertionId) return;
            const draft = assertionGovernanceDrafts.get(assertionId);
            assertionGovernanceDrafts.delete(assertionId);
            if (currentEditorialEvidence) renderEditorialEvidence(currentEditorialEvidence);
            if (draft) focusGovernanceAction(assertionId, draft.action);
          });
        });
        body.querySelectorAll<HTMLTextAreaElement>("[data-governance-reason]").forEach((textarea) => {
          textarea.addEventListener("input", () => {
            const root = textarea.closest<HTMLElement>("[data-assertion-governance]");
            const assertionId = root?.dataset.assertionId;
            const draft = assertionId ? assertionGovernanceDrafts.get(assertionId) : undefined;
            if (!draft || !assertionId) return;
            if (draft.hasAttemptedSubmission) {
              try {
                draft.idempotencyKey = createAssertionGovernanceIdempotencyKey();
                draft.hasAttemptedSubmission = false;
                setGovernanceFormMessage(assertionId, "Reason changed; a fresh request key will be used for this new decision.", false);
              } catch (error: unknown) {
                setGovernanceFormMessage(assertionId, errorMessage(error, "Could not create a fresh action key."), true);
                return;
              }
            }
            draft.reason = textarea.value;
            const suffix = governanceDomSuffix(assertionId);
            const hint = $<HTMLElement>(`assertion-governance-hint-${suffix}`);
            if (hint) hint.textContent = `${textarea.value.length}/${ASSERTION_GOVERNANCE_REASON_MAX_LENGTH} characters. The reason is trimmed before it is sent.`;
          });
        });
        body.querySelectorAll<HTMLFormElement>("[data-governance-form]").forEach((form) => {
          form.addEventListener("submit", (event) => {
            event.preventDefault();
            const assertionId = form.dataset.assertionId;
            if (assertionId) void submitAssertionGovernance(assertionId);
          });
        });
      }

      function focusGovernanceAction(assertionId: string, action: AssertionGovernanceAction): void {
        window.setTimeout(() => {
          const button = [...document.querySelectorAll<HTMLButtonElement>("[data-governance-action]")]
            .find((candidate) => candidate.dataset.assertionId === assertionId && candidate.dataset.governanceAction === action);
          button?.focus();
        }, 0);
      }

      function focusEditorialEvidenceSummary(): void {
        const summary = $<HTMLElement>("claims-evidence-summary");
        if (!summary) return;
        summary.tabIndex = -1;
        summary.focus();
      }

      function renderEditorialEvidence(data: EditorialClusterEvidence): void {
        currentEditorialEvidence = data;
        const summary = $<HTMLElement>("claims-evidence-summary");
        const body = $<HTMLElement>("claims-evidence-body");
        if (!summary || !body) return;
        summary.textContent = `${plural(data.claimCount, "canonical claim")} · ${plural(data.admittedAssertionCount, "admitted assertion")} · ${plural(data.eligibleAttachmentCount, "eligible attachment")}`;
        if (data.claimCount === 0) {
          body.innerHTML = '<p class="meta">No canonical claims are currently mapped to this story. No extraction or mapping was started.</p>';
          return;
        }
        body.innerHTML = `${data.claimsTruncated ? `<p class="meta" style="margin:0 0 0.6rem;">Showing ${data.claims.length} of ${data.claimCount} canonical claims.</p>` : ""}${data.claims.map(claimMarkup).join("")}`;
        bindAssertionGovernanceControls();
      }

      function resetEditorialEvidenceState(hide = true): void {
        evidenceRequestToken += 1;
        currentEditorialEvidence = null;
        disposeAssertionGovernanceDrafts();
        const panel = document.getElementById("claims-evidence-panel");
        const summary = $<HTMLElement>("claims-evidence-summary");
        const body = $<HTMLElement>("claims-evidence-body");
        if (panel && hide) panel.style.display = "none";
        if (summary) summary.textContent = "";
        if (body) body.replaceChildren();
      }

      async function loadEditorialEvidence(clusterId: number): Promise<boolean> {
        const panel = document.getElementById("claims-evidence-panel");
        const summary = $<HTMLElement>("claims-evidence-summary");
        const body = $<HTMLElement>("claims-evidence-body");
        if (!panel || !summary || !body) return false;
        disposeAssertionGovernanceDrafts();
        currentEditorialEvidence = null;
        const requestToken = ++evidenceRequestToken;
        panel.style.display = "block";
        summary.textContent = "Loading…";
        body.innerHTML = '<p class="meta">Loading canonical claims and evidence…</p>';
        try {
          const res = await adminFetch(`/api/admin/cluster-evidence?clusterId=${clusterId}`);
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const data = await res.json() as EditorialClusterEvidence;
          if (requestToken !== evidenceRequestToken) return false;
          renderEditorialEvidence(data);
          return true;
        } catch (error: unknown) {
          if (requestToken !== evidenceRequestToken) return false;
          summary.textContent = "Unavailable";
          body.innerHTML = `<p class="meta" style="color:var(--ev-disputed);">Canonical claims and evidence could not be loaded. ${escapeHTML(errorMessage(error, "Unknown error"))}</p>`;
          return false;
        }
      }

      function resetSelectedClusterState(): void {
        const select = $<HTMLSelectElement>("cluster-select");
        if (select) select.value = "";
        currentSources = [];
        resetEditorialEvidenceState();

        const sourcePanel = document.getElementById("source-material");
        const sourceList = document.getElementById("source-list");
        const sourceCount = document.getElementById("source-count");
        const aiButton = $<HTMLButtonElement>("ai-analyze-btn");
        const relatedButton = $<HTMLButtonElement>("find-related-btn");
        const aiResult = document.getElementById("ai-result");
        const relatedItems = document.getElementById("related-items");
        if (sourcePanel) sourcePanel.style.display = "none";
        if (sourceList) sourceList.replaceChildren();
        if (sourceCount) sourceCount.textContent = "";
        if (aiButton) aiButton.disabled = true;
        if (relatedButton) relatedButton.disabled = true;
        if (aiResult) { aiResult.style.display = "none"; aiResult.replaceChildren(); }
        if (relatedItems) { relatedItems.style.display = "none"; relatedItems.replaceChildren(); }

        for (const id of ["pub-headline", "pub-summary", "pub-analysis", "pub-why", "pub-image"]) {
          const field = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null;
          if (field) field.value = "";
        }
        checkPublishReady();
      }

      $<HTMLSelectElement>("cluster-select")?.addEventListener("change", async function() {
        const clusterId = parseInt(this.value || "");
        const panel = document.getElementById("source-material");
        const list = document.getElementById("source-list");
        const count = document.getElementById("source-count");
        const aiBtn = $<HTMLButtonElement>("ai-analyze-btn");
        const aiResult = document.getElementById("ai-result");
        if (!panel || !list || !count) return;

        if (!clusterId) { panel.style.display = "none"; currentSources = []; resetEditorialEvidenceState(); return; }
        panel.style.display = "block";
        list.innerHTML = '<p class="meta">Loading source material…</p>';
        count.textContent = "";
        if (aiBtn) aiBtn.disabled = true;
        if (aiResult) aiResult.style.display = "none";
        const findRelatedBtn = $<HTMLButtonElement>("find-related-btn");
        if (findRelatedBtn) findRelatedBtn.disabled = true;
        const relatedDiv = document.getElementById("related-items");
        if (relatedDiv) relatedDiv.style.display = "none";
        currentSources = [];

        // Pre-fill form fields from cluster data if available
        const detail = clusterDetail[clusterId];
        if (detail) {
          const summaryEl = $<HTMLTextAreaElement>("pub-summary");
          const whyEl = $<HTMLInputElement>("pub-why");
          if (summaryEl && detail.summary && !summaryEl.value.trim()) summaryEl.value = detail.summary;
          if (whyEl && detail.why && !whyEl.value.trim()) whyEl.value = detail.why;
          checkPublishReady();
        }

        // Source material and canonical evidence have independent read-only lifecycles.
        void loadEditorialEvidence(clusterId);

        try {
          const res = await adminFetch(`/api/admin/cluster-sources?clusterId=${clusterId}`);
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const sources: Array<{ title: string; url: string; excerpt: string | null; sourceName: string; sourceTier: string; publishedAt: string | null }> = await res.json();

          currentSources = sources.map(s => ({ title: s.title, excerpt: s.excerpt }));
          if (aiBtn) aiBtn.disabled = aiBtn.dataset.aiEnabled !== "true" || currentSources.length === 0;
          if (findRelatedBtn) findRelatedBtn.disabled = false;

          count.textContent = `(${sources.length} source${sources.length !== 1 ? "s" : ""})`;
          if (sources.length > 0) {
            list.innerHTML = sources.map((s, i) => `
              <div style="padding:0.5rem 0;border-bottom:1px solid var(--border);${i === sources.length - 1 ? "border-bottom:none;" : ""}">
                <div style="display:flex;gap:0.5rem;align-items:baseline;flex-wrap:wrap;">
                  <span class="badge badge-sm" style="font-size:0.65rem;">Tier ${escapeHTML(s.sourceTier)}</span>
                  <span class="meta" style="font-size:0.7rem;">${escapeHTML(s.sourceName)}</span>
                </div>
                <a href="${escapeHTML(safeExternalUrl(s.url))}" target="_blank" rel="noopener" style="font-size:0.85rem;font-weight:550;display:block;margin-top:0.2rem;">${escapeHTML(s.title)}</a>
                ${s.excerpt ? `<p class="meta" style="font-size:0.75rem;margin-top:0.15rem;line-height:1.4;">${escapeHTML(s.excerpt.slice(0, 300))}${s.excerpt.length > 300 ? "…" : ""}</p>` : ""}
              </div>
            `).join("");
          } else {
            // No feed sources — fall back to the cluster's own summary/headline for AI analysis
            const summaryEl = $<HTMLTextAreaElement>("pub-summary");
            const headlineEl = $<HTMLInputElement>("pub-headline");
            const summary = summaryEl?.value?.trim();
            const headline = headlineEl?.value?.trim() || (this.options[this.selectedIndex]?.textContent ?? "Untitled");
            if (summary && summary.length >= 20) {
              currentSources = [{ title: headline, excerpt: summary }];
              if (aiBtn) aiBtn.disabled = aiBtn.dataset.aiEnabled !== "true";
              list.innerHTML = `<div class="card" style="padding:0.75rem;background:color-mix(in oklch, var(--accent) 6%, transparent);"><p class="meta" style="font-size:0.8rem;">No feed sources — AI will analyze the editorial summary below.</p></div>`;
            } else {
              list.innerHTML = `<div class="card" style="padding:0.75rem;"><p class="meta" style="font-size:0.8rem;">No source material available. Write a summary (min 20 chars) to enable AI analysis, or publish manually.</p></div>`;
            }
          }
        } catch (e) {
          list.innerHTML = '<p class="meta" style="color:var(--ev-disputed);">Failed to load source material.</p>';
          console.error(e);
        }
      });

      // AI Analyze button — sends source material to TRACE AI for analysis
      $<HTMLButtonElement>("ai-analyze-btn")?.addEventListener("click", async () => {
        const enabled = $<HTMLButtonElement>("ai-analyze-btn")?.dataset.aiEnabled === "true";
        if (!enabled) { status("Editorial AI is disabled for this deployment.", true); return; }
        if (currentSources.length === 0) { status("No source material loaded.", true); return; }

        const btn = $<HTMLButtonElement>("ai-analyze-btn");
        const resultDiv = document.getElementById("ai-result");
        if (btn) { btn.disabled = true; btn.textContent = "🤖 Analyzing…"; }
        if (resultDiv) { resultDiv.style.display = "block"; resultDiv.innerHTML = '<p class="meta">Asking TRACE AI to analyze these sources…</p>'; }
        status("AI analyzing…", false);

        // Send at most 30 sources (API cap), prioritizing primary + Tier A
        const MAX_AI_SOURCES = 30;
        let aiSources = currentSources;
        if (aiSources.length > MAX_AI_SOURCES) {
          aiSources = aiSources.slice(0, MAX_AI_SOURCES);
          status(`AI analyzing ${MAX_AI_SOURCES} of ${currentSources.length} sources…`, false);
        }

        try {
          const res = await adminFetch("/api/admin/ai-triage", {
            method: "POST",
            body: JSON.stringify({ sources: aiSources }),
          });

          if (!res.ok) {
            const err = await res.json().catch(() => ({ error: `HTTP ${res.status}` })) as { error?: string; requestId?: string };
            const requestReference = err.requestId ? ` (request ${err.requestId})` : "";
            throw new Error(`${err.error || `HTTP ${res.status}`}${requestReference}`);
          }

          const analysis: {
            isNewsworthy: boolean;
            headline: string;
            summary: string;
            editorialAnalysis?: string;
            whyItMatters: string;
            keyFacts: string[];
            proposedConfidence?: string;
            caveats?: string[];
            requestId: string;
          } = await res.json();

          // Populate form fields
          const headlineEl = $<HTMLInputElement>("pub-headline");
          const summaryEl = $<HTMLTextAreaElement>("pub-summary");
          const analysisEl = $<HTMLTextAreaElement>("pub-analysis");
          const whyEl = $<HTMLInputElement>("pub-why");
          if (headlineEl && analysis.headline) headlineEl.value = analysis.headline;
          if (summaryEl && analysis.summary) { summaryEl.value = analysis.summary; checkPublishReady(); }
          if (analysisEl && analysis.editorialAnalysis) analysisEl.value = analysis.editorialAnalysis;
          if (whyEl && analysis.whyItMatters) whyEl.value = analysis.whyItMatters;

          // Show result
          if (resultDiv) {
            const newsBadge = analysis.isNewsworthy
              ? '<span class="badge badge-confirmed" style="font-size:0.7rem;">News</span>'
              : '<span class="badge badge-outdated" style="font-size:0.7rem;">Routine update</span>';
            resultDiv.innerHTML = `
              <div style="display:flex;gap:0.5rem;align-items:center;margin-bottom:0.5rem;">
                ${newsBadge}
                <span class="meta" style="font-size:0.75rem;">AI analysis — review before publishing</span>
              </div>
              ${analysis.keyFacts.length > 0 ? `<p class="meta" style="font-size:0.8rem;margin-bottom:0.35rem;"><strong>Key facts:</strong> ${analysis.keyFacts.map(escapeHTML).join(" · ")}</p>` : ""}
              <p class="meta" style="font-size:0.75rem;color:var(--muted);">Fields populated above. Edit as needed, then publish.${analysis.requestId ? ` Request ${escapeHTML(analysis.requestId)}.` : ""}</p>
            `;
          }

          status(analysis.isNewsworthy ? "AI: This looks like news. Review and publish." : "AI: This appears to be a routine update.", false);
        } catch (e: unknown) {
          if (resultDiv) {
            const errorText = document.createElement("p");
            errorText.className = "meta";
            errorText.style.color = "var(--ev-disputed)";
            errorText.textContent = `AI analysis failed: ${errorMessage(e, "Unknown error")}`;
            resultDiv.replaceChildren(errorText);
          }
          status("AI analysis failed.", true);
          console.error(e);
        } finally {
          if (btn) {
            btn.disabled = btn.dataset.aiEnabled !== "true" || currentSources.length === 0;
            btn.textContent = btn.dataset.aiEnabled === "true" ? "🤖 AI Analyze" : "AI Analyze disabled";
          }
        }
      });

      // Find Related Coverage — search ingested items for related coverage
      $<HTMLButtonElement>("find-related-btn")?.addEventListener("click", async () => {
        const relatedDiv = document.getElementById("related-items");
        const btn = $<HTMLButtonElement>("find-related-btn");
        if (!relatedDiv || !btn) return;

        const clusterId = parseInt($<HTMLSelectElement>("cluster-select")?.value ?? "0");
        if (!clusterId) { status("Select a cluster first.", true); return; }

        btn.disabled = true;
        btn.textContent = "🔍 Searching…";
        relatedDiv.style.display = "block";
        relatedDiv.innerHTML = '<p class="meta">Searching ingested items for related coverage…</p>';

        try {
          const res = await adminFetch(`/api/admin/related-items?clusterId=${clusterId}`);
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const data: { clusterItemCount: number; items: Array<{ id: number; title: string; sourceName: string; sourceTier: string; kind: "ingested_coverage" | "cluster" | "published_story"; clusterId: number | null; url: string | null; publishedAt: string | null; score: number; matchReasons: string[]; claimOptions: Array<{ id: string; text: string }>; review: { action: string; state: "accepted" | "rejected"; reviewedBy: string; reviewedAt: string } | null; affectedRecords: { publishedStories: Array<{ id: number; title: string; url: string | null }>; knowledgePages: Array<{ id: string; title: string; visibility: string; url: string }> } }> } = await res.json();

          if (data.items.length === 0) {
            relatedDiv.innerHTML = '<p class="meta">No related items found in the ingested pool. This story may be unique.</p>';
          } else {
            relatedDiv.innerHTML = `<p class="meta" style="margin-bottom:0.5rem;"><strong>${data.items.length} related result(s)</strong> found from ingested coverage, other clusters, and published stories.</p>` +
              data.items.slice(0, 15).map(item => {
                const kindLabel = item.kind === "published_story" ? "published story" : item.kind === "cluster" ? "cluster" : "coverage";
                const sourceLabel = item.sourceTier === "TRACE" ? "TRACE" : item.sourceTier === "cluster" ? "cluster" : `Tier ${item.sourceTier}`;
                const title = item.url
                  ? `<a href="${escapeHTML(safeExternalUrl(item.url))}" target="_blank" rel="noopener" style="font-weight:600;">${escapeHTML(item.title.slice(0, 90))}${item.title.length > 90 ? '…' : ''}</a>`
                  : `<span style="font-weight:600;">${escapeHTML(item.title.slice(0, 90))}${item.title.length > 90 ? '…' : ''}</span>`;
                const targetAttribute = item.kind === "ingested_coverage"
                  ? `data-target-feed="${item.id}"`
                  : `data-target-story="${item.clusterId ?? item.id}"`;
                const actionOptions = item.kind === "ingested_coverage"
                  ? '<option value="attach_evidence">Attach evidence</option><option value="reject">Reject</option>'
                  : '<option value="same_event">Same event</option><option value="follow_up">Follow-up</option><option value="related_context">Related context</option><option value="contradiction">Contradiction</option><option value="correction">Correction</option><option value="supersession">Supersession</option><option value="comparison">Comparison</option><option value="reject">Reject</option>';
                const claimSelector = item.kind === "ingested_coverage"
                  ? `<select data-related-claim style="font-size:0.7rem;padding:0.2rem;" ${item.claimOptions.length === 0 ? "disabled" : ""}><option value="">${item.claimOptions.length === 0 ? "No canonical claims" : "Select claim…"}</option>${item.claimOptions.map((claim: { id: string; text: string }) => `<option value="${escapeHTML(claim.id)}">${escapeHTML(claim.text.slice(0, 70))}</option>`).join("")}</select>`
                  : "";
                const reviewLabel = item.review
                  ? `<span class="badge" style="font-size:0.6rem;color:${item.review.state === "accepted" ? "var(--ev-confirmed)" : "var(--ev-disputed)"};">${escapeHTML(item.review.state)}: ${escapeHTML(item.review.action)}</span>`
                  : `<span style="display:flex;gap:0.35rem;align-items:center;flex-wrap:wrap;">${claimSelector}<select data-related-action ${targetAttribute} style="font-size:0.7rem;padding:0.2rem;"><option value="">Review action…</option>${actionOptions}</select><button type="button" class="btn btn-secondary" data-related-review ${targetAttribute} style="font-size:0.7rem;padding:0.2rem 0.45rem;">Apply</button></span>`;
                const affected = item.affectedRecords;
                const affectedLabel = affected && (affected.publishedStories.length > 0 || affected.knowledgePages.length > 0)
                  ? `<div class="meta" style="font-size:0.7rem;margin-top:0.25rem;"><strong>Affected:</strong> ${affected.publishedStories.map(story => story.url ? `<a href="${escapeHTML(story.url)}">${escapeHTML(story.title)}</a>` : escapeHTML(story.title)).join(", ")}${affected.knowledgePages.length > 0 ? `${affected.publishedStories.length > 0 ? " · " : ""}knowledge: ${affected.knowledgePages.map(page => `<a href="${escapeHTML(page.url)}">${escapeHTML(page.title)}</a>`).join(", ")}` : ""}</div>`
                  : "";
                return `
                <div style="padding:0.4rem 0;border-bottom:1px solid var(--border-light);font-size:0.82rem;">
                  <div style="display:flex;gap:0.5rem;align-items:baseline;flex-wrap:wrap;">
                    <span class="badge" style="font-size:0.6rem;">${kindLabel}</span>
                    <span class="badge" style="font-size:0.6rem;">${escapeHTML(sourceLabel)}</span>
                    <span class="badge" style="font-size:0.6rem;">score ${item.score}</span>
                    ${title}
                  </div>
                  <div class="meta" style="font-size:0.7rem;margin-top:0.15rem;">
                    ${escapeHTML(item.sourceName)} · ${item.matchReasons.map(escapeHTML).join(" · ")} ${item.publishedAt ? '· ' + escapeHTML(item.publishedAt.slice(0, 10)) : ''}
                  </div>
                  <div style="margin-top:0.35rem;">${reviewLabel}</div>
                  ${affectedLabel}
                </div>
              `;
              }).join("");

            relatedDiv.querySelectorAll<HTMLButtonElement>("[data-related-review]").forEach((reviewButton) => {
              reviewButton.addEventListener("click", async () => {
                const row = reviewButton.closest("div[style*='border-bottom']");
                const actionSelect = row?.querySelector("[data-related-action]") as unknown as HTMLSelectElement | null;
                const action = actionSelect?.value ?? "";
                if (!action) { status("Choose a related-item action first.", true); return; }
                const sourceStoryId = parseInt(String(clusterId));
                const targetStoryId = reviewButton.dataset.targetStory ? parseInt(reviewButton.dataset.targetStory) : undefined;
                const targetFeedItemId = reviewButton.dataset.targetFeed ? parseInt(reviewButton.dataset.targetFeed) : undefined;
                const canonicalClaimId = (row?.querySelector("[data-related-claim]") as unknown as HTMLSelectElement | null)?.value || undefined;
                if (action === "attach_evidence" && !canonicalClaimId) { status("Select a canonical claim before attaching evidence.", true); return; }
                let explanation = "";
                if (["contradiction", "correction", "supersession"].includes(action)) {
                  explanation = window.prompt("Explain this editorial relationship (at least 10 characters):", "")?.trim() ?? "";
                  if (explanation.length < 10) { status("An explanation of at least 10 characters is required.", true); return; }
                }
                reviewButton.disabled = true;
                try {
                  const reviewResponse = await adminFetch("/api/admin/related-items", {
                    method: "POST",
                    body: JSON.stringify({ sourceStoryId, targetStoryId, targetFeedItemId, canonicalClaimId, action, explanation }),
                  });
                  const reviewData = await reviewResponse.json() as { error?: string; status?: string };
                  if (!reviewResponse.ok) throw new Error(reviewData.error || `HTTP ${reviewResponse.status}`);
                  const reviewRow = reviewButton.parentElement;
                  if (reviewRow) reviewRow.innerHTML = `<span class="badge" style="font-size:0.6rem;color:${reviewData.status === "accepted" ? "var(--ev-confirmed)" : "var(--ev-disputed)"};">${escapeHTML(reviewData.status ?? "reviewed")}: ${escapeHTML(action)}</span>`;
                  status(action === "attach_evidence" ? "Evidence review recorded; evidence score unchanged." : "Related story review recorded.", false);
                } catch (error: unknown) {
                  reviewButton.disabled = false;
                  status(errorMessage(error, "Related review failed."), true);
                }
              });
            });
          }
          status(`Found ${data.items.length} related item(s).`, false);
        } catch (e: unknown) {
          relatedDiv.innerHTML = `<p class="meta" style="color:var(--ev-disputed);">Search failed: ${errorMessage(e, "Unknown error")}</p>`;
          status("Related search failed.", true);
        } finally {
          btn.disabled = false;
          btn.textContent = "🔍 Find Related";
        }
      });

      // Archive button — hide boring clusters from the draft list
      $<HTMLButtonElement>("archive-btn")?.addEventListener("click", async () => {
        const select = $<HTMLSelectElement>("cluster-select");
        const clusterId = parseInt(select?.value || "");
        if (!clusterId || isNaN(clusterId)) { status("Select a cluster first.", true); return; }

        const btn = $<HTMLButtonElement>("archive-btn");
        if (btn) { btn.disabled = true; btn.textContent = "Archiving…"; }
        status("Archiving…", false);

        try {
          const res = await adminFetch(`/api/admin/archive-cluster`, {
            method: "POST",
            body: JSON.stringify({ clusterId }),
          });
          if (!res.ok) { const d = await res.json() as { error?: string }; throw new Error(d.error || `HTTP ${res.status}`); }
          allClusters = allClusters.filter((cluster) => cluster.id !== clusterId);
          delete clusterDetail[clusterId];
          resetSelectedClusterState();
          applyClusterFilters();
          status("Archived.", false);
        } catch (e: unknown) {
          status(errorMessage(e, "Archive failed"), true);
        } finally {
          if (btn) { btn.disabled = false; btn.textContent = "Archive (not news)"; }
          checkPublishReady();
        }
      });

      // Publish button
      $<HTMLButtonElement>("publish-btn")?.addEventListener("click", async () => {
        const select = $<HTMLSelectElement>("cluster-select");
        const clusterId = parseInt(select?.value || "");
        if (!clusterId || isNaN(clusterId)) { status("Select a cluster first.", true); return; }

        const summary = $<HTMLTextAreaElement>("pub-summary")?.value?.trim();
        if (!summary || summary.length < 20) { status("Summary must be at least 20 characters.", true); return; }

        const body = {
          clusterId,
          summary,
          headline: $<HTMLInputElement>("pub-headline")?.value?.trim() || undefined,
          editorialAnalysis: $<HTMLTextAreaElement>("pub-analysis")?.value?.trim() || undefined,
          whyItMatters: $<HTMLInputElement>("pub-why")?.value?.trim() || undefined,
          headlineImageUrl: $<HTMLInputElement>("pub-image")?.value?.trim() || undefined,
        };

        const btn = $<HTMLButtonElement>("publish-btn");
        if (btn) { btn.disabled = true; btn.textContent = "Publishing…"; }
        status("Publishing…", false);

        try {
          const res = await adminFetch(`/api/admin/publish-story`, {
            method: "POST",
            body: JSON.stringify(body),
          });
          const data: { error?: string; story?: { slug: string; headline: string } } = await res.json();

          if (!res.ok) {
            status(data.error || `HTTP ${res.status}`, true);
          } else {
            allClusters = allClusters.filter((cluster) => cluster.id !== clusterId);
            delete clusterDetail[clusterId];
            resetSelectedClusterState();
            applyClusterFilters();
            status(data.story ? `Published! Slug: ${data.story.slug}` : "Published.", false);
            const recent = document.getElementById("recent-publishes");
            if (recent && data.story) {
              const line = document.createElement("div");
              const link = document.createElement("a");
              link.href = `/stories/${encodeURIComponent(data.story.slug)}`;
              link.style.fontWeight = "550";
              link.textContent = data.story.headline;
              const timestamp = document.createElement("span");
              timestamp.className = "meta";
              timestamp.textContent = ` — ${new Date().toLocaleTimeString()}`;
              line.appendChild(link);
              line.appendChild(timestamp);
              if (recent.textContent?.trim() === "—") recent.replaceChildren(line);
              else recent.insertBefore(line, recent.firstChild);
            }
          }
        } catch (e) {
          status("Network error — check console.", true);
          console.error(e);
        } finally {
          if (btn) { btn.disabled = false; btn.textContent = "Publish Story"; }
          checkPublishReady();
        }
      });

    </script>

    <!-- Record a correction -->
    <section style="margin-top:2.5rem;">
      <h2>Record a Correction</h2>
      <p class="meta" style="margin-bottom:1rem;">
        Use <code>POST /admin/correct</code> to record a correction against a cluster or claim.
        Corrections are permanent and visible on the public <a href="/corrections">corrections ledger</a>.
      </p>

      <div class="card" style="background:var(--surface-2);">
        <h3 style="font-size:0.95rem;margin-bottom:0.75rem;">API Reference</h3>
        <pre style="font-size:0.78rem;line-height:1.55;overflow-x:auto;padding:0.75rem;background:var(--bg);border-radius:var(--radius);" class="mono"><code>POST /admin/correct
Content-Type: application/json

{'{'}
  "clusterId": 1,              // optional: target cluster
  "claimId": null,             // optional: target claim (use clusterId OR claimId)
  "correctionType": "factual_error | rating_change | licence_correction |
                     pricing_correction | benchmark_correction | supersession |
                     deprecation | methodology_update | other",
  "previousStatement": "Original text that was incorrect",
  "updatedStatement": "Corrected text",
  "previousEvidenceStatus": "vendor_reported",    // optional
  "updatedEvidenceStatus": "corrected",           // optional, defaults to "corrected"
  "reason": "Why the correction was made",
  "humanApprovalNote": "Publisher approval note explaining why this high-impact correction is authorised",
  "evidenceUrl": "https://...",                   // optional
  "impact": "What changed as a result"            // optional
{'}'}</code></pre>
      </div>

      <div class="card" style="margin-top:1rem;background:var(--surface-2);">
        <h3 style="font-size:0.95rem;margin-bottom:0.75rem;">Correction Types</h3>
        <div style="display:flex;flex-wrap:wrap;gap:0.5rem;">
          {[
            "factual_error", "rating_change", "licence_correction", "pricing_correction",
            "benchmark_correction", "supersession", "deprecation", "methodology_update", "other"
          ].map(t => (
            <code style="font-size:0.75rem;padding:0.2em 0.5em;background:var(--bg);border-radius:4px;">{t}</code>
          ))}
        </div>
      </div>
    </section>
  </div>
</AdminLayout>
