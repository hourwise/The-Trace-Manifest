---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { auditNewsletterAction, newsletterCounts, newsletterSecret, newsletterSignupEnabled } from "../../lib/server/newsletter";
import { emailFrom, processEmailOutbox, transportFromEnv } from "../../lib/server/email-outbox";

export const prerender = false;
// Publisher-only, like TRACE Desk: the page reads subscriber state and can run
// the outbox. It shows counts only, never addresses.
if (Astro.locals.operator?.role !== "publisher") return new Response("Forbidden", { status: 403, headers: { "Cache-Control": "no-store" } });

const env = Astro.locals.runtime.env;
const signupOpen = newsletterSignupEnabled(env);
const transport = transportFromEnv(env);
const from = emailFrom(env);
const secret = newsletterSecret(env);
const deliveryReady = Boolean(transport && from && secret);
let actionMessage: string | null = null;
let actionError: string | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  if (form.get("_action") !== "process") {
    actionError = "Unknown action.";
  } else if (!deliveryReady) {
    actionError = "Email delivery is not configured, so nothing was sent.";
  } else {
    try {
      const result = await processEmailOutbox({ db: env.DB, transport: transport!, secret: secret!, from: from!, siteUrl: new URL(Astro.request.url).origin, limit: 10 });
      await auditNewsletterAction(env.DB, Astro.locals.operator, "process_email_outbox", "succeeded",
        `claimed:${result.claimed};sent:${result.sent};retried:${result.retried};failed:${result.failed};cancelled:${result.cancelled}`);
      actionMessage = `Processed ${result.claimed} queued email(s): ${result.sent} sent, ${result.retried} to retry, ${result.failed} failed, ${result.cancelled} cancelled.`;
    } catch {
      actionError = "The outbox run failed. Nothing further was sent.";
    }
  }
}

let counts: Awaited<ReturnType<typeof newsletterCounts>> | null = null;
let loadError: string | null = null;
try {
  counts = await newsletterCounts(env.DB);
} catch {
  loadError = "Newsletter tables are unavailable (migration 0078 not applied).";
}
Astro.response.headers.set("Cache-Control", "no-store");
---

<AdminLayout title="Admin — Newsletter" description="TRACE Weekly subscriptions and email outbox.">
  <div class="wrap" style="max-width:820px;">
    <h1>TRACE Weekly</h1>
    <p class="meta"><a href="/admin">Admin home</a></p>
    {actionMessage && <p class="card" role="status">{actionMessage}</p>}
    {actionError && <p class="card" role="alert" style="color:var(--ev-disputed);">{actionError}</p>}

    <section class="card" style="margin-top:1rem;">
      <h2 style="font-size:1.1rem;">Status</h2>
      <ul class="meta" data-newsletter-gates>
        <li>Signup: {signupOpen ? "open" : "closed (TRACE_NEWSLETTER_SIGNUP_ENABLED and secrets required)"}</li>
        <li>Delivery: {deliveryReady ? `ready (${transport!.name})` : "off (TRACE_EMAIL_DELIVERY_ENABLED, provider, API key, sender and secret required)"}</li>
      </ul>
    </section>

    <section class="card" style="margin-top:1rem;">
      <h2 style="font-size:1.1rem;">Counts</h2>
      {loadError ? <p class="meta">{loadError}</p> : counts && (
        <div class="grid grid--2" data-newsletter-counts>
          <div><h3 style="font-size:0.95rem;">Subscribers</h3><ul class="meta">{["pending", "confirmed", "unsubscribed", "suppressed"].map((status) => <li>{status}: {counts!.subscribers[status] ?? 0}</li>)}</ul></div>
          <div><h3 style="font-size:0.95rem;">Outbox</h3><ul class="meta">{["queued", "sending", "sent", "failed", "cancelled"].map((status) => <li>{status}: {counts!.outbox[status] ?? 0}</li>)}</ul></div>
        </div>
      )}
    </section>

    <section class="card" style="margin-top:1rem;">
      <h2 style="font-size:1.1rem;">Outbox</h2>
      <p class="meta">Sends at most 10 due emails. Failed sends are retried only when you run the queue again, at most three attempts each.</p>
      <form method="POST">
        <input type="hidden" name="_action" value="process" />
        <button type="submit" class="btn btn-primary" disabled={!deliveryReady}>Process outbox</button>
      </form>
    </section>
  </div>
</AdminLayout>
